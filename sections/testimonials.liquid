<section class="section{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" id="reviews" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.show_summary -%}
      <div class="reviews-summary">
        <span class="reviews-summary__score">{{ section.settings.score }}</span>
        {% render 'stars', rating: section.settings.score %}
        <span class="muted">{{ section.settings.summary_text }}</span>
      </div>
    {%- endif -%}
    <div class="reviews-grid">
      {%- for block in section.blocks -%}
        <article class="review-card{% if forloop.index > section.settings.initial_count %} is-hidden{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="review-card__media">{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.author }}</div>
          {%- elsif block.settings.fallback_image != blank -%}
            <div class="review-card__media"><img src="{{ block.settings.fallback_image | asset_url }}" alt="{{ block.settings.author | escape }}" loading="lazy" width="800" height="600"></div>
          {%- endif -%}
          {% render 'stars', rating: block.settings.rating %}
          {%- if block.settings.title != blank -%}<h3 class="review-card__title">{{ block.settings.title }}</h3>{%- endif -%}
          <div class="review-card__body">{{ block.settings.text }}</div>
          <div class="review-card__author">
            <span><strong>{{ block.settings.author }}</strong>{% if block.settings.location != blank %} · <span class="muted">{{ block.settings.location }}</span>{% endif %}</span>
            {%- if block.settings.verified -%}<span class="verified">{% render 'icon', icon: 'verified' %} {{ 'general.verified' | t }}</span>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > section.settings.initial_count -%}
      <div class="reviews-more"><button type="button" class="button button--secondary" data-reviews-more>{{ 'general.load_more_reviews' | t }}</button></div>
    {%- endif -%}
    {%- if section.settings.write_review_link != blank -%}
      <p class="text-center" style="margin-top:20px"><a class="link muted" href="{{ section.settings.write_review_link }}">{{ 'general.write_review' | t }}</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 30,
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "light" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real nights, real people" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "“I actually slept through.”" },
    { "type": "checkbox", "id": "show_summary", "label": "Show rating summary", "default": true },
    { "type": "range", "id": "score", "label": "Average score", "min": 1, "max": 5, "step": 0.1, "default": 4.8 },
    { "type": "text", "id": "summary_text", "label": "Summary text", "default": "Based on 1,248 reviews" },
    { "type": "range", "id": "initial_count", "label": "Reviews shown before 'load more'", "min": 3, "max": 30, "step": 1, "default": 6 },
    { "type": "url", "id": "write_review_link", "label": "Write a review link", "default": "/pages/review" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "fallback_image", "label": "Dummy photo asset", "info": "e.g. review-1.svg" },
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "title", "label": "Title", "default": "Finally!" },
      { "type": "richtext", "id": "text", "label": "Review", "default": "<p>Write the review here.</p>" },
      { "type": "text", "id": "author", "label": "Author", "default": "Customer" },
      { "type": "text", "id": "location", "label": "Location" },
      { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
    ] }
  ],
  "presets": [{ "name": "Testimonials", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
