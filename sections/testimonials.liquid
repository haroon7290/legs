{%- comment -%}
  Reviews: rating summary (score count-up, star fill, animated breakdown bars) and
  review cards that scroll in two rows in opposite directions (or a static grid).
  Text-only cards with initials avatars. Styles and script are included in this file.
{%- endcomment -%}
{%- liquid
  assign total = section.blocks.size
  assign rows = 2
  if section.settings.rows == '1' or total < 6
    assign rows = 1
  endif
  assign half = total | plus: 1 | divided_by: 2
  assign row_one = ''
  assign row_two = ''
  assign grid_cards = ''
  assign speed = section.settings.speed | times: total | divided_by: 6
  if speed < 20
    assign speed = 20
  endif
-%}

{%- for block in section.blocks -%}
  {%- liquid
    assign name_parts = block.settings.author | strip | split: ' '
    assign initials = name_parts.first | slice: 0 | upcase
    if name_parts.size > 1
      assign second = name_parts.last | remove: '.' | slice: 0 | upcase
      assign initials = initials | append: second
    endif
    assign tone = forloop.index | modulo: 3
  -%}
  {%- capture card_inner -%}
    <div class="rv-card__top">
      {% render 'stars', rating: block.settings.rating %}
      {%- if block.settings.verified -%}<span class="rv-card__badge">{% render 'icon', icon: 'verified' %} Verified buyer</span>{%- endif -%}
    </div>
    {%- if block.settings.title != blank -%}<h3 class="rv-card__title">{{ block.settings.title }}</h3>{%- endif -%}
    <div class="rv-card__body">{{ block.settings.text }}</div>
    <div class="rv-card__author">
      <span class="rv-card__avatar rv-card__avatar--{{ tone }}" aria-hidden="true">{{ initials }}</span>
      <span><strong class="rv-card__name">{{ block.settings.author }}</strong>{% if block.settings.location != blank %}<span class="rv-card__location">{{ block.settings.location }}</span>{% endif %}</span>
    </div>
  {%- endcapture -%}
  {%- capture card -%}<article class="rv-card" {{ block.shopify_attributes }}>{{ card_inner }}</article>{%- endcapture -%}
  {%- liquid
    if rows == 1 or forloop.index <= half
      assign row_one = row_one | append: card
    else
      assign row_two = row_two | append: card
    endif
  -%}
  {%- capture grid_card -%}<article class="rv-card reveal{% if forloop.index > section.settings.initial_count %} is-hidden{% endif %}" style="--d: {{ forloop.index | modulo: 6 }}" {{ block.shopify_attributes }}>{{ card_inner }}</article>{%- endcapture -%}
  {%- assign grid_cards = grid_cards | append: grid_card -%}
{%- endfor -%}

<section class="section rv{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" id="reviews" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- if section.settings.show_summary -%}
      <div class="rv__summary reveal">
        <div class="rv__score">
          <span class="rv__score-value" data-count="{{ section.settings.score }}" data-decimals="1">{{ section.settings.score }}</span>
          <div>
            <span class="rv__score-stars">{% render 'stars', rating: section.settings.score %}</span>
            {%- if section.settings.summary_text != blank -%}<p class="rv__score-text">{{ section.settings.summary_text }}</p>{%- endif -%}
          </div>
        </div>

        {%- if section.settings.show_breakdown -%}
          <ul class="rv__bars" aria-label="Rating breakdown">
            {%- for i in (1..5) reversed -%}
              {%- assign key = 'pct_' | append: i -%}
              {%- assign pct = section.settings[key] -%}
              <li class="rv__bar" style="--w: {{ pct }}%; --b: {{ 5 | minus: i }}">
                <span class="rv__bar-label">{{ i }} {% render 'icon', icon: 'star' %}</span>
                <span class="rv__bar-track"><span class="rv__bar-fill"></span></span>
                <span class="rv__bar-pct">{{ pct }}%</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.recommend_value != blank -%}
          <div class="rv__recommend">
            <span class="rv__recommend-value"><span data-count="{{ section.settings.recommend_value }}">{{ section.settings.recommend_value }}</span>%</span>
            <p>{{ section.settings.recommend_text }}</p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.layout == 'marquee' -%}
    <div class="rv__rows reveal" style="--rv-speed: {{ speed }}s">
      <div class="rv__row">
        <div class="rv__track">
          <div class="rv__group">{{ row_one }}</div>
          <div class="rv__group" aria-hidden="true">{{ row_one }}</div>
        </div>
      </div>
      {%- if rows == 2 -%}
        <div class="rv__row rv__row--reverse">
          <div class="rv__track">
            <div class="rv__group">{{ row_two }}</div>
            <div class="rv__group" aria-hidden="true">{{ row_two }}</div>
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="page-width">
      <div class="rv__grid">{{ grid_cards }}</div>
      {%- if total > section.settings.initial_count -%}
        <div class="rv__more"><button type="button" class="button button--secondary" data-rv-more>Show more reviews</button></div>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  /* Summary ------------------------------------------------------------------ */
  .rv__summary { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 40px; max-width: 980px; margin: -12px auto 48px; padding: 28px 32px; border-radius: var(--radius-lg, 14px); background: var(--color-surface, #fbf8f3); border: 1px solid var(--line, rgba(19, 26, 38, .12)); }
  .section--contrast .rv__summary { background: var(--color-ink-2, #18233a); border-color: var(--line-dark, rgba(243, 237, 227, .14)); }
  .rv__score { display: flex; align-items: center; gap: 16px; }
  .rv__score-value { font-family: var(--font-heading); font-weight: 800; font-size: 3.6rem; line-height: 1; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
  .rv__score-stars .stars svg { width: 20px; height: 20px; }
  .rv__score-text { margin: 6px 0 0; font-size: .88rem; color: var(--color-text-muted, #5d6270); }
  .rv__bars { list-style: none; margin: 0; padding: 0 40px; display: grid; gap: 7px; border-left: 1px solid var(--line, rgba(19, 26, 38, .12)); border-right: 1px solid var(--line, rgba(19, 26, 38, .12)); }
  .rv__bar { display: grid; grid-template-columns: 34px minmax(0, 1fr) 38px; align-items: center; gap: 10px; font-size: .82rem; font-variant-numeric: tabular-nums; }
  .rv__bar-label { display: inline-flex; align-items: center; gap: 3px; font-weight: 600; }
  .rv__bar-label svg { width: 12px; height: 12px; color: var(--star, #e8682a); }
  .rv__bar-track { height: 8px; border-radius: 8px; background: var(--color-bg-alt, #ebe2d4); overflow: hidden; }
  .rv__bar-fill { display: block; height: 100%; width: var(--w, 0%); border-radius: 8px; background: var(--color-accent, #e8682a); }
  .rv__bar-pct { text-align: right; color: var(--color-text-muted, #5d6270); }
  .rv__recommend { text-align: center; max-width: 160px; }
  .rv__recommend-value { display: block; font-family: var(--font-heading); font-weight: 800; font-size: 2.4rem; line-height: 1; color: var(--color-accent, #e8682a); font-variant-numeric: tabular-nums; }
  .rv__recommend p { margin: 6px 0 0; font-size: .84rem; color: var(--color-text-muted, #5d6270); }
  .section--contrast .rv__score-text, .section--contrast .rv__bar-pct, .section--contrast .rv__recommend p { color: var(--color-on-dark-muted, rgba(243, 237, 227, .66)); }
  .section--contrast .rv__bars { border-color: var(--line-dark, rgba(243, 237, 227, .14)); }
  .section--contrast .rv__bar-track { background: rgba(243, 237, 227, .1); }

  /* Summary animation: stars fill one by one, bars grow */
  .js .rv__summary .rv__score-stars svg { opacity: .15; transform: scale(.6); transition: opacity .35s, transform .45s var(--ease, ease); }
  .rv__summary.is-visible .rv__score-stars svg { opacity: 1; transform: none; }
  .rv__summary.is-visible .rv__score-stars svg:nth-child(2) { transition-delay: .12s; }
  .rv__summary.is-visible .rv__score-stars svg:nth-child(3) { transition-delay: .24s; }
  .rv__summary.is-visible .rv__score-stars svg:nth-child(4) { transition-delay: .36s; }
  .rv__summary.is-visible .rv__score-stars svg:nth-child(5) { transition-delay: .48s; }
  .js .rv__summary .rv__bar-fill { width: 0; transition: width 1.1s cubic-bezier(.25, .8, .25, 1); }
  .rv__summary.is-visible .rv__bar-fill { width: var(--w, 0%); transition-delay: calc(.3s + var(--b, 0) * .1s); }

  /* Review cards ----------------------------------------------------------- */
  .rv-card { display: flex; flex-direction: column; gap: 10px; padding: 22px 22px 20px; border-radius: var(--radius-lg, 14px); background: var(--color-surface, #fbf8f3); color: var(--color-text, #131a26); border: 1px solid var(--line, rgba(19, 26, 38, .12)); transition: transform .35s var(--ease, ease), border-color .35s, box-shadow .35s; }
  .rv-card:hover { transform: translateY(-4px); border-color: rgba(232, 104, 42, .45); box-shadow: 0 16px 32px -22px rgba(14, 21, 35, .45); }
  .section--contrast .rv-card { background: var(--color-ink-2, #18233a); color: var(--color-on-dark, #f3ede3); border-color: var(--line-dark, rgba(243, 237, 227, .14)); }
  .rv-card__top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .rv-card__top .stars svg { width: 15px; height: 15px; }
  .rv-card__badge { display: inline-flex; align-items: center; gap: 4px; font-size: .74rem; font-weight: 600; color: var(--color-success, #2f7d5b); white-space: nowrap; }
  .rv-card__badge svg { width: 14px; height: 14px; }
  .rv-card__title { margin: 4px 0 0; font-size: 1.04rem; line-height: 1.3; }
  .rv-card__body { font-size: .94rem; color: var(--color-text-muted, #5d6270); }
  .rv-card__body p { margin: 0; }
  .section--contrast .rv-card__body, .section--contrast .rv-card__location { color: var(--color-on-dark-muted, rgba(243, 237, 227, .66)); }
  .rv-card__author { display: flex; align-items: center; gap: 10px; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line, rgba(19, 26, 38, .12)); }
  .section--contrast .rv-card__author { border-top-color: var(--line-dark, rgba(243, 237, 227, .14)); }
  .rv-card__avatar { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; font-size: .78rem; font-weight: 700; letter-spacing: .02em; background: var(--color-ink, #0e1523); color: var(--color-on-dark, #f3ede3); }
  .rv-card__avatar--1 { background: var(--color-accent, #e8682a); color: #fff; }
  .rv-card__avatar--2 { background: var(--color-bg-alt, #ebe2d4); color: var(--color-text, #131a26); }
  .rv-card__name { display: block; font-size: .9rem; }
  .rv-card__location { display: block; font-size: .8rem; color: var(--color-text-muted, #5d6270); }

  /* Scrolling rows ----------------------------------------------------------- */
  .rv__rows { display: grid; gap: 16px; overflow: hidden; padding: 6px 0 10px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); }
  .rv__row { overflow: hidden; padding: 6px 0; }
  .rv__track { display: flex; width: max-content; animation: rvScroll var(--rv-speed, 60s) linear infinite; }
  .rv__row--reverse .rv__track { animation-direction: reverse; }
  .rv__row:hover .rv__track, .rv__row:focus-within .rv__track { animation-play-state: paused; }
  .rv__group { display: flex; align-items: stretch; gap: 16px; padding-right: 16px; }
  .rv__group .rv-card { width: 340px; flex-shrink: 0; }
  @keyframes rvScroll { to { transform: translateX(-50%); } }

  /* Grid layout ---------------------------------------------------------------- */
  .rv__grid { columns: 3 300px; column-gap: 18px; }
  .rv__grid .rv-card { break-inside: avoid; margin-bottom: 18px; }
  .rv__grid .rv-card.is-hidden { display: none; }
  .rv__grid .rv-card.rv-card--in { animation: rvIn .5s var(--ease, ease) both; }
  .rv__more { text-align: center; margin-top: 10px; }
  @keyframes rvIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  @media (max-width: 849px) {
    .rv__summary { grid-template-columns: minmax(0, 1fr); gap: 22px; padding: 22px 20px; margin-bottom: 36px; }
    .rv__score { justify-content: center; }
    .rv__bars { padding: 20px 0; border-left: 0; border-right: 0; border-top: 1px solid var(--line, rgba(19, 26, 38, .12)); border-bottom: 1px solid var(--line, rgba(19, 26, 38, .12)); }
    .rv__recommend { max-width: none; }
    .rv__group .rv-card { width: 290px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rv__track { animation: none; width: auto; }
    .rv__row { overflow-x: auto; }
    .rv__group[aria-hidden="true"] { display: none; }
    .js .rv__summary .rv__score-stars svg { opacity: 1; transform: none; transition: none; }
    .js .rv__summary .rv__bar-fill { width: var(--w, 0%); transition: none; }
    .rv-card { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-rv-more]');
    if (!button) return;
    var section = button.closest('.rv');
    var hidden = Array.prototype.slice.call(section.querySelectorAll('.rv-card.is-hidden'), 0, 6);
    hidden.forEach(function (card, i) {
      card.classList.remove('is-hidden');
      card.classList.add('is-visible', 'rv-card--in');
      card.style.animationDelay = (i * 70) + 'ms';
    });
    if (!section.querySelector('.rv-card.is-hidden')) button.hidden = true;
  });
{% endjavascript %}

{% schema %}
{
  "name": "Reviews",
  "max_blocks": 30,
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "alt" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real nights, real people" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "“I actually slept through.”" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Rating summary", "info": "Use your real rating and review numbers." },
    { "type": "checkbox", "id": "show_summary", "label": "Show rating summary", "default": true },
    { "type": "range", "id": "score", "label": "Average score", "min": 1, "max": 5, "step": 0.1, "default": 4.8 },
    { "type": "text", "id": "summary_text", "label": "Text under the stars", "default": "Based on 1,248 reviews" },
    { "type": "checkbox", "id": "show_breakdown", "label": "Show star breakdown", "default": true },
    { "type": "range", "id": "pct_5", "label": "5 stars (%)", "min": 0, "max": 100, "step": 1, "default": 86 },
    { "type": "range", "id": "pct_4", "label": "4 stars (%)", "min": 0, "max": 100, "step": 1, "default": 10 },
    { "type": "range", "id": "pct_3", "label": "3 stars (%)", "min": 0, "max": 100, "step": 1, "default": 3 },
    { "type": "range", "id": "pct_2", "label": "2 stars (%)", "min": 0, "max": 100, "step": 1, "default": 1 },
    { "type": "range", "id": "pct_1", "label": "1 star (%)", "min": 0, "max": 100, "step": 1, "default": 0 },
    { "type": "text", "id": "recommend_value", "label": "Would recommend (%)", "default": "97", "info": "Leave empty to hide." },
    { "type": "text", "id": "recommend_text", "label": "Recommend text", "default": "would recommend Legs Night" },
    { "type": "header", "content": "Review cards" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "marquee", "label": "Scrolling rows" }, { "value": "grid", "label": "Grid" }], "default": "marquee" },
    { "type": "select", "id": "rows", "label": "Scrolling rows", "options": [{ "value": "2", "label": "Two rows" }, { "value": "1", "label": "One row" }], "default": "2", "info": "Two rows need at least 6 reviews." },
    { "type": "range", "id": "speed", "label": "Scroll duration", "min": 20, "max": 120, "step": 5, "unit": "s", "default": 60, "info": "Higher is slower." },
    { "type": "range", "id": "initial_count", "label": "Reviews shown before 'Show more' (grid)", "min": 3, "max": 30, "step": 1, "default": 6 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "Finally!" },
        { "type": "richtext", "id": "text", "label": "Review", "default": "<p>Write the review here.</p>" },
        { "type": "text", "id": "author", "label": "Name", "default": "Customer" },
        { "type": "text", "id": "location", "label": "Location" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "Reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
