<section class="section{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" id="how-it-works" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="grid grid--3 steps">
      {%- for block in section.blocks -%}
        <div class="step reveal" {{ block.shopify_attributes }}>
          {%- assign fb = 'step-' | append: forloop.index | append: '.svg' -%}
          <div class="step__media">{% render 'image', image: block.settings.image, fallback: fb, alt: block.settings.title, sizes: '(min-width: 990px) 33vw, 100vw' %}</div>
          <span class="step__num">{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}<div class="text-center muted rte" style="margin-top:32px;font-size:.92rem">{{ section.settings.footnote }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "alt" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Simple pressure. Calmer legs." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Firm, steady pressure under the arch gives your nervous system a different signal to focus on — so the urge to move can fade.</p>" },
    { "type": "richtext", "id": "footnote", "label": "Footnote" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Step" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this step." }
    ] }
  ],
  "presets": [{ "name": "How it works", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
