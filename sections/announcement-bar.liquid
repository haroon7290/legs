{%- if section.blocks.size > 0 -%}
<div class="announcement-bar" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }};--marquee-speed:{{ section.settings.speed | times: section.blocks.size | times: 4 }}s" {{ section.shopify_attributes }}>
  <div class="announcement-bar__track">
    {%- for i in (1..2) -%}
      <div class="announcement-bar__group"{% if i == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <span class="announcement-bar__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
          </span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#070b13" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f3ede3" },
    { "type": "range", "id": "speed", "label": "Scroll speed (higher is slower)", "min": 2, "max": 10, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free tracked UK delivery" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "announcement" }] }]
}
{% endschema %}
