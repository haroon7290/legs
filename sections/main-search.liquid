<div class="page-width main-page">
  <h1>{{ 'general.search' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" class="newsletter-form" style="max-width:620px;margin:0 auto 40px">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}" aria-label="{{ 'general.search' | t }}">
    <input type="hidden" name="type" value="product">
    <button type="submit" class="button">{{ 'general.search' | t }}</button>
  </form>
  {%- if search.performed -%}
    <div class="product-grid" style="--columns:3">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
      {%- else -%}
        <p class="muted">{{ 'general.no_results' | t: terms: search.terms }}</p>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
