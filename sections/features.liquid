{%- comment -%}
  Why Legs Night: a bento grid with a large animated "pressure" card and feature cards.
  - The large card draws a foot outline, wraps the criss-cross bands around it and pulses
    pressure rings under the arch when it scrolls into view.
  - Feature cards can be light, dark or orange, and can show a number that counts up.
  Styles are included in this file, so it works on its own.
{%- endcomment -%}
<section class="section why{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="why__grid{% if section.settings.show_visual %} why__grid--visual{% endif %}">
      {%- if section.settings.show_visual -%}
        <div class="why__visual reveal">
          <div class="why__visual-copy">
            {%- if section.settings.visual_eyebrow != blank -%}<span class="why__visual-eyebrow">{{ section.settings.visual_eyebrow }}</span>{%- endif -%}
            <h3 class="why__visual-title">{{ section.settings.visual_heading }}</h3>
            {%- if section.settings.visual_text != blank -%}<p class="why__visual-text">{{ section.settings.visual_text }}</p>{%- endif -%}
          </div>

          <svg class="why__art" viewBox="0 0 420 290" role="img" aria-label="{{ section.settings.visual_heading | escape }}">
            <defs>
              <clipPath id="WhyFootClip-{{ section.id }}">
                <path d="M88 10 C86 70 88 120 84 160 C80 185 66 200 66 222 C66 244 82 254 104 254 C150 254 170 238 210 238 C250 238 270 256 300 256 L330 256 C362 256 380 248 380 234 C380 220 366 212 344 208 C300 200 250 186 210 166 C188 155 172 138 166 110 C162 80 164 40 166 10 Z"/>
              </clipPath>
            </defs>
            <g clip-path="url(#WhyFootClip-{{ section.id }})">
              <path class="why-band why-band--1" d="M146 262 L252 168"/>
              <path class="why-band why-band--2" d="M270 262 L190 150"/>
              <path class="why-band why-band--3" d="M296 262 L288 182"/>
              <path class="why-band why-band--sole" d="M120 252 C160 246 180 236 210 236 C250 236 272 250 312 252"/>
            </g>
            <path class="why-foot" d="M88 10 C86 70 88 120 84 160 C80 185 66 200 66 222 C66 244 82 254 104 254 C150 254 170 238 210 238 C250 238 270 256 300 256 L330 256 C362 256 380 248 380 234 C380 220 366 212 344 208 C300 200 250 186 210 166 C188 155 172 138 166 110 C162 80 164 40 166 10"/>
            <line class="why-ground" x1="30" y1="272" x2="400" y2="272"/>
            <g class="why-pulse" transform="translate(210 240)">
              <circle class="why-ring why-ring--1" r="46"/>
              <circle class="why-ring why-ring--2" r="46"/>
              <circle class="why-ring why-ring--3" r="46"/>
              <circle class="why-dot" r="6"/>
            </g>
          </svg>

          <ul class="why__points">
            {%- for i in (1..3) -%}
              {%- assign key = 'visual_point_' | append: i -%}
              {%- if section.settings[key] != blank -%}
                <li style="--p: {{ i }}">{{ section.settings[key] }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- liquid
          assign stat = block.settings.stat_value | strip
          assign stat_number = stat | times: 1
          assign stat_check = stat_number | append: ''
          assign countable = false
          if stat != blank and stat_check == stat
            assign countable = true
          endif
        -%}
        <div class="why-card why-card--{{ block.settings.color }} reveal" style="--d: {{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="why-card__icon">{% render 'icon', icon: block.settings.icon %}</span>
          <h3 class="why-card__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="why-card__text">{{ block.settings.text }}</p>{%- endif -%}
          {%- if stat != blank -%}
            <p class="why-card__stat">
              <span class="why-card__value"{% if countable %} data-count="{{ stat }}"{% endif %}>{{ stat }}</span>
              {%- if block.settings.stat_suffix != blank -%}<span class="why-card__suffix">{{ block.settings.stat_suffix }}</span>{%- endif -%}
            </p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* Layout: bento grid ---------------------------------------------------- */
  .why__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .why__grid--visual .why__visual { grid-column: span 2; grid-row: span 2; }
  @media (max-width: 989px) {
    .why__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .why__grid--visual .why__visual { grid-column: 1 / -1; grid-row: auto; }
  }
  @media (max-width: 560px) { .why__grid { grid-template-columns: minmax(0, 1fr); } }

  /* Feature cards ---------------------------------------------------------- */
  .why-card { position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 8px; min-height: 230px; padding: 26px 24px 24px; border-radius: var(--radius-lg, 14px); background: var(--color-surface, #fbf8f3); color: var(--color-text, #131a26); border: 1px solid var(--line, rgba(19, 26, 38, .12)); transition: transform .45s var(--ease, ease), border-color .45s, box-shadow .45s; }
  .why-card::after { content: ""; position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: var(--color-accent, #e8682a); transform: scaleX(0); transform-origin: left; transition: transform .6s var(--ease, ease); }
  .why-card:hover { transform: translateY(-5px); border-color: rgba(232, 104, 42, .45); box-shadow: 0 18px 36px -24px rgba(14, 21, 35, .45); }
  .why-card:hover::after { transform: scaleX(1); }
  .why-card__icon { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; margin-bottom: 10px; border-radius: 50%; background: rgba(232, 104, 42, .1); color: var(--color-accent, #e8682a); transition: background .35s, color .35s, transform .45s var(--ease, ease); }
  .why-card__icon svg { width: 22px; height: 22px; }
  .why-card:hover .why-card__icon { background: var(--color-accent, #e8682a); color: #fff; transform: rotate(-8deg) scale(1.06); }
  .why-card__title { margin: 0; font-size: 1.15rem; }
  .why-card__text { margin: 0; font-size: .95rem; color: var(--color-text-muted, #5d6270); }
  .why-card__stat { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 8px; margin: auto 0 0; padding-top: 16px; }
  .why-card__value { font-family: var(--font-heading); font-weight: 800; font-size: 2.5rem; line-height: 1; letter-spacing: -.04em; color: var(--color-accent, #e8682a); font-variant-numeric: tabular-nums; }
  .why-card__suffix { font-size: .85rem; font-weight: 600; color: var(--color-text-muted, #5d6270); }

  .why-card--dark { background: var(--color-ink, #0e1523); color: var(--color-on-dark, #f3ede3); border-color: transparent; }
  .why-card--dark .why-card__text, .why-card--dark .why-card__suffix { color: var(--color-on-dark-muted, rgba(243, 237, 227, .66)); }
  .why-card--dark .why-card__icon { background: rgba(243, 237, 227, .08); }
  .why-card--accent { background: var(--color-accent, #e8682a); color: #fff; border-color: transparent; }
  .why-card--accent .why-card__text, .why-card--accent .why-card__suffix { color: rgba(255, 255, 255, .85); }
  .why-card--accent .why-card__icon { background: rgba(255, 255, 255, .18); color: #fff; }
  .why-card--accent .why-card__value { color: #fff; }
  .why-card--accent::after { background: #fff; }
  .why-card--accent:hover .why-card__icon { background: #fff; color: var(--color-accent, #e8682a); }

  /* Icons draw themselves when the card appears */
  .js .why-card.reveal .why-card__icon svg * { stroke-dasharray: 120; stroke-dashoffset: 120; }
  .js .why-card.is-visible .why-card__icon svg * { animation: whyDraw 1.1s var(--ease, ease) forwards; animation-delay: calc(var(--d, 0) * 90ms + 250ms); }

  /* Large animated card ------------------------------------------------------ */
  .why__visual { position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 18px; min-height: 480px; padding: 32px 32px 28px; border-radius: var(--radius-lg, 14px); background: var(--color-ink, #0e1523); color: var(--color-on-dark, #f3ede3); }
  .why__visual-eyebrow { display: inline-block; font-size: .74rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--color-accent, #e8682a); margin-bottom: 10px; }
  .why__visual-title { margin: 0 0 8px; font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.12; max-width: 420px; }
  .why__visual-text { margin: 0; max-width: 440px; color: var(--color-on-dark-muted, rgba(243, 237, 227, .66)); }
  .why__art { display: block; width: 100%; max-width: 520px; height: auto; margin: auto auto 0; overflow: visible; }
  .why-foot { fill: none; stroke: var(--color-on-dark, #f3ede3); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; opacity: .9; }
  .why-ground { stroke: var(--color-on-dark, #f3ede3); stroke-opacity: .15; stroke-width: 1.5; stroke-dasharray: 4 7; }
  .why-band { fill: none; stroke: var(--color-accent, #e8682a); stroke-width: 22; stroke-linecap: butt; }
  .why-band--sole { stroke-width: 16; }
  .why-ring { fill: none; stroke: var(--color-accent, #e8682a); stroke-width: 2.5; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .why-dot { fill: var(--color-accent, #e8682a); }
  .why__points { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .why__points li { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; border: 1px solid var(--line-dark, rgba(243, 237, 227, .14)); font-size: .84rem; font-weight: 600; }
  .why__points li::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent, #e8682a); }

  /* Animation sequence: outline draws, bands wrap in, chips appear, then the rings pulse */
  .js .why__visual .why-foot { stroke-dasharray: 1600; stroke-dashoffset: 1600; }
  .js .why__visual .why-band { stroke-dasharray: 220; stroke-dashoffset: 220; }
  .js .why__visual .why-dot { transform-box: fill-box; transform-origin: center; transform: scale(0); }
  .js .why__visual .why__points li { opacity: 0; transform: translateY(8px); transition: opacity .5s var(--ease, ease), transform .5s var(--ease, ease); }
  .why__visual.is-visible .why-foot { animation: whyDraw 1.8s cubic-bezier(.45, .05, .25, 1) .2s forwards; }
  .why__visual.is-visible .why-band { animation: whyDraw .7s var(--ease, ease) forwards; }
  .why__visual.is-visible .why-band--1 { animation-delay: 1.3s; }
  .why__visual.is-visible .why-band--2 { animation-delay: 1.55s; }
  .why__visual.is-visible .why-band--3 { animation-delay: 1.8s; }
  .why__visual.is-visible .why-band--sole { animation-delay: 1.15s; }
  .why__visual.is-visible .why-dot { animation: whyPop .5s var(--ease, ease) 2.2s forwards, whyBeat 2.4s ease-in-out 2.8s infinite; }
  .why__visual.is-visible .why-ring { animation: whyPulse 3s cubic-bezier(.2, .6, .35, 1) infinite; }
  .why__visual.is-visible .why-ring--1 { animation-delay: 2.4s; }
  .why__visual.is-visible .why-ring--2 { animation-delay: 3.4s; }
  .why__visual.is-visible .why-ring--3 { animation-delay: 4.4s; }
  .why__visual.is-visible .why__points li { opacity: 1; transform: none; transition-delay: calc(1.9s + var(--p, 0) * 140ms); }

  @keyframes whyDraw { to { stroke-dashoffset: 0; } }
  @keyframes whyPop { to { transform: scale(1); } }
  @keyframes whyBeat { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.35); } }
  @keyframes whyPulse { 0% { transform: scale(.15); opacity: 1; } 80% { opacity: .05; } 100% { transform: scale(1.25); opacity: 0; } }

  @media (max-width: 989px) {
    .why__visual { min-height: 0; padding: 26px 22px 22px; }
    .why__art { max-width: 420px; margin-top: 8px; }
  }
  @media (max-width: 560px) { .why-card { min-height: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .js .why__visual .why-foot, .js .why__visual .why-band, .js .why-card.reveal .why-card__icon svg * { stroke-dashoffset: 0; animation: none; }
    .js .why__visual .why-dot { transform: none; animation: none; }
    .why-ring { display: none; }
    .js .why__visual .why__points li { opacity: 1; transform: none; }
    .why-card, .why-card::after, .why-card__icon { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why Legs Night",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Legs Night" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the nights that won't settle" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Animated pressure card" },
    { "type": "checkbox", "id": "show_visual", "label": "Show animated card", "default": true },
    { "type": "text", "id": "visual_eyebrow", "label": "Card eyebrow", "default": "The difference" },
    { "type": "text", "id": "visual_heading", "label": "Card heading", "default": "Pressure, right where it counts" },
    { "type": "textarea", "id": "visual_text", "label": "Card text", "default": "The bands cross over the top of your foot and hold firm, steady pressure right under the arch, all night." },
    { "type": "text", "id": "visual_point_1", "label": "Point 1", "default": "Crosses in an X" },
    { "type": "text", "id": "visual_point_2", "label": "Point 2", "default": "Holds the arch" },
    { "type": "text", "id": "visual_point_3", "label": "Point 3", "default": "Toes and heel stay free" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
          { "value": "leaf", "label": "Leaf" }, { "value": "pill", "label": "Pill" }, { "value": "moon-outline", "label": "Moon" }, { "value": "feet", "label": "Feet" },
          { "value": "compress", "label": "Pressure" }, { "value": "washing", "label": "Washable" }, { "value": "heart", "label": "Heart" }, { "value": "clock", "label": "Clock" },
          { "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Truck" }
        ] },
        { "type": "select", "id": "color", "label": "Card colour", "options": [{ "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }, { "value": "accent", "label": "Orange" }], "default": "light" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe the feature." },
        { "type": "text", "id": "stat_value", "label": "Number (optional)", "info": "Whole numbers count up when the card appears, e.g. 90." },
        { "type": "text", "id": "stat_suffix", "label": "Text after the number", "info": "e.g. nights risk-free" }
      ]
    }
  ],
  "presets": [{ "name": "Why Legs Night", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
