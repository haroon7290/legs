<section class="section{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="grid grid--4">
      {%- for block in section.blocks -%}
        <div class="feature reveal" {{ block.shopify_attributes }}>
          <div class="feature__icon">{% render 'icon', icon: block.settings.icon %}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Icon features",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Legs Night" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the nights that won't settle" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
        { "value": "leaf", "label": "Leaf" }, { "value": "pill", "label": "Pill" }, { "value": "moon-outline", "label": "Moon" }, { "value": "feet", "label": "Feet" },
        { "value": "compress", "label": "Pressure" }, { "value": "washing", "label": "Washable" }, { "value": "heart", "label": "Heart" }, { "value": "clock", "label": "Clock" },
        { "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Truck" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Describe the feature." }
    ] }
  ],
  "presets": [{ "name": "Icon features", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
