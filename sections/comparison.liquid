{%- comment -%} Each row block holds one value per column: yes / no / any text {%- endcomment -%}
<section class="section{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="compare reveal">
      <div class="compare-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">{{ 'general.feature' | t }}</span></th>
              <th scope="col" class="compare__us"><span class="compare__head">{{ section.settings.col_1 }}</span></th>
              <th scope="col"><span class="compare__head">{{ section.settings.col_2 }}</span></th>
              <th scope="col"><span class="compare__head">{{ section.settings.col_3 }}</span></th>
              {%- if section.settings.col_4 != blank -%}<th scope="col"><span class="compare__head">{{ section.settings.col_4 }}</span></th>{%- endif -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <td>{{ block.settings.label }}</td>
                {%- for i in (1..4) -%}
                  {%- if i == 4 and section.settings.col_4 == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign val_key = 'value_' | append: i -%}
                  {%- assign v = block.settings[val_key] | strip -%}
                  {%- assign v_down = v | downcase -%}
                  <td{% if i == 1 %} class="compare__us"{% endif %}>
                    {%- if v_down == 'yes' -%}<span class="yes">{% render 'icon', icon: 'tick' %}<span class="visually-hidden">{{ 'general.yes' | t }}</span></span>
                    {%- elsif v_down == 'no' -%}<span class="no">{% render 'icon', icon: 'cross' %}<span class="visually-hidden">{{ 'general.no' | t }}</span></span>
                    {%- else -%}{{ v }}{%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
    {%- if section.settings.footnote != blank -%}<div class="text-center muted rte" style="margin-top:20px;font-size:.85rem">{{ section.settings.footnote }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "max_blocks": 12,
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Drug-free relief, made for bed." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>How Legs Relief compares with the usual ways people try to settle restless legs.</p>" },
    { "type": "text", "id": "col_1", "label": "Column 1 (highlighted)", "default": "Legs Relief" },
    { "type": "text", "id": "col_2", "label": "Column 2", "default": "Medication" },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "Compression socks" },
    { "type": "text", "id": "col_4", "label": "Column 4 (optional)", "default": "Stretching & walking" },
    { "type": "richtext", "id": "footnote", "label": "Footnote" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Feature", "default": "Feature" },
        { "type": "paragraph", "content": "Type yes or no for a ✓ / ✕ icon, or any text." },
        { "type": "text", "id": "value_1", "label": "Column 1", "default": "yes" },
        { "type": "text", "id": "value_2", "label": "Column 2", "default": "no" },
        { "type": "text", "id": "value_3", "label": "Column 3", "default": "no" },
        { "type": "text", "id": "value_4", "label": "Column 4", "default": "no" }
      ]
    }
  ],
  "presets": [{ "name": "Comparison table", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
