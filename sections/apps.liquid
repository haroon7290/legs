<div class="page-width{% if section.settings.include_margins %} section--tight{% endif %}" {{ section.shopify_attributes }}>
  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Apps",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "include_margins", "label": "Add spacing around apps", "default": true }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Apps" }]
}
{% endschema %}
