{%- comment -%}
  Fit finder: three quick questions (shoe size, who it's for, when legs play up). The answer
  card shows a size, a bundle with its live price and a tip; "Use these choices" sets them in
  the buy box on the page and scrolls there.
  Styles and script are included in this file, so it works on its own.
{%- endcomment -%}
<section class="section ff{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" id="fit-finder" {{ section.shopify_attributes }}>
  <div class="page-width ff__grid">
    <div class="ff__intro reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="ff__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="ff__text">{{ section.settings.text }}</div>{%- endif -%}
      <ul class="ff__perks">
        {%- for i in (1..3) -%}
          {%- assign key = 'perk_' | append: i -%}
          {%- if section.settings[key] != blank -%}<li>{% render 'icon', icon: 'tick' %}<span>{{ section.settings[key] }}</span></li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="ff__card reveal" data-fit-finder>
      <div class="ff__top">
        <span class="ff__count" data-ff-count aria-live="polite">1 / 3</span>
        <button type="button" class="ff__back" data-ff-back hidden>{% render 'icon', icon: 'chevron-left' %} Back</button>
      </div>
      <div class="ff__progress" aria-hidden="true"><span data-ff-bar></span></div>

      <div class="ff__step is-active" data-step="1">
        <h3 class="ff__q">{{ section.settings.q1 }}</h3>
        <div class="ff__opts ff__opts--two">
          {%- for i in (1..2) -%}
            {%- assign l_key = 'size_' | append: i | append: '_label' -%}
            {%- assign v_key = 'size_' | append: i | append: '_value' -%}
            <button type="button" class="ff__opt" data-size="{{ section.settings[v_key] | escape }}">
              <span class="ff__opt-main">{{ section.settings[l_key] }}</span>
              <span class="ff__opt-sub">Size {{ section.settings[v_key] }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="ff__step" data-step="2">
        <h3 class="ff__q">{{ section.settings.q2 }}</h3>
        <div class="ff__opts">
          <button type="button" class="ff__opt" data-qty="1"><span class="ff__opt-main">{{ section.settings.who_1 }}</span></button>
          <button type="button" class="ff__opt" data-qty="2"><span class="ff__opt-main">{{ section.settings.who_2 }}</span></button>
          <button type="button" class="ff__opt" data-qty="2" data-partner><span class="ff__opt-main">{{ section.settings.who_3 }}</span></button>
          <button type="button" class="ff__opt" data-qty="3"><span class="ff__opt-main">{{ section.settings.who_4 }}</span></button>
        </div>
      </div>

      <div class="ff__step" data-step="3">
        <h3 class="ff__q">{{ section.settings.q3 }}</h3>
        <div class="ff__opts">
          {%- for i in (1..3) -%}
            {%- assign w_key = 'when_' | append: i -%}
            {%- assign t_key = 'tip_' | append: i -%}
            <button type="button" class="ff__opt" data-tip="{{ section.settings[t_key] | escape }}"><span class="ff__opt-main">{{ section.settings[w_key] }}</span></button>
          {%- endfor -%}
        </div>
      </div>

      <div class="ff__result" data-ff-result hidden>
        <p class="ff__result-eyebrow">{{ section.settings.result_heading }}</p>
        <dl class="ff__picks">
          <div><dt>Size</dt><dd data-ff-size></dd></div>
          <div><dt>Bundle</dt><dd data-ff-bundle></dd></div>
          <div><dt>Price</dt><dd data-ff-price></dd></div>
        </dl>
        <p class="ff__tip" data-ff-tip></p>
        {%- if section.settings.partner_note != blank -%}<p class="ff__partner" data-ff-partner hidden>{{ section.settings.partner_note }}</p>{%- endif -%}
        <button type="button" class="button button--full" data-ff-apply>{{ section.settings.apply_label }} {% render 'icon', icon: 'arrow-right' %}</button>
        <button type="button" class="ff__restart" data-ff-restart>{{ section.settings.restart_label }}</button>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ff__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: center; gap: 56px; }
  .ff__title { margin-bottom: 14px; }
  .ff__text { margin-bottom: 22px; font-size: 1.04rem; color: var(--color-text-muted, #5d6270); }
  .section--contrast .ff__text { color: var(--color-on-dark-muted, rgba(243, 237, 227, .66)); }
  .ff__perks { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .ff__perks li { display: flex; align-items: center; gap: 10px; font-weight: 600; }
  .ff__perks svg { flex-shrink: 0; width: 18px; height: 18px; padding: 3px; border-radius: 50%; background: rgba(232, 104, 42, .14); color: var(--color-accent, #e8682a); box-sizing: content-box; }

  .ff__card { position: relative; padding: 26px; border-radius: var(--radius-lg, 14px); background: var(--color-surface, #fbf8f3); color: var(--color-text, #131a26); border: 1px solid var(--line, rgba(19, 26, 38, .12)); box-shadow: 0 24px 50px -36px rgba(14, 21, 35, .55); }
  .ff__top { display: flex; align-items: center; justify-content: space-between; min-height: 28px; }
  .ff__count { font-size: .78rem; font-weight: 700; letter-spacing: .12em; color: var(--color-text-muted, #5d6270); font-variant-numeric: tabular-nums; }
  .ff__back { display: inline-flex; align-items: center; gap: 4px; padding: 4px 0; border: 0; background: none; color: var(--color-text-muted, #5d6270); font: inherit; font-size: .86rem; font-weight: 600; cursor: pointer; }
  .ff__back svg { width: 14px; height: 14px; }
  .ff__back:hover { color: var(--color-text, #131a26); }
  .ff__progress { height: 4px; margin: 10px 0 22px; border-radius: 4px; background: var(--color-bg-alt, #ebe2d4); overflow: hidden; }
  .ff__progress span { display: block; width: 33.4%; height: 100%; border-radius: 4px; background: var(--color-accent, #e8682a); transition: width .5s var(--ease, ease); }

  .ff__step { display: none; }
  .ff__step.is-active { display: block; animation: ffIn .45s var(--ease, ease) both; }
  .ff__q { margin: 0 0 16px; font-size: 1.3rem; }
  .ff__opts { display: grid; gap: 10px; }
  .ff__opts--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ff__opt { display: grid; gap: 2px; width: 100%; padding: 16px 18px; border-radius: var(--radius, 10px); border: 1px solid var(--line-strong, rgba(19, 26, 38, .22)); background: var(--color-bg, #f4eee4); color: inherit; font: inherit; text-align: left; cursor: pointer; transition: border-color .2s, background-color .2s, transform .2s var(--ease, ease); }
  .ff__opt:hover { border-color: var(--color-text, #131a26); transform: translateY(-1px); }
  .ff__opt:focus-visible { outline: 2px solid var(--color-accent, #e8682a); outline-offset: 2px; }
  .ff__opt.is-picked { border-color: var(--color-accent, #e8682a); background: #fff8f2; box-shadow: inset 0 0 0 1px var(--color-accent, #e8682a); }
  .ff__opt-main { font-weight: 700; }
  .ff__opts--two .ff__opt-main { font-size: 1.15rem; }
  .ff__opt-sub { font-size: .84rem; color: var(--color-text-muted, #5d6270); }

  .ff__result { animation: ffIn .5s var(--ease, ease) both; }
  .ff__result-eyebrow { margin: 0 0 12px; font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--color-accent, #e8682a); }
  .ff__picks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0 0 16px; }
  .ff__picks div { padding: 14px; border-radius: var(--radius, 10px); background: var(--color-ink, #0e1523); color: var(--color-on-dark, #f3ede3); }
  .ff__picks dt { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; opacity: .65; }
  .ff__picks dd { margin: 4px 0 0; font-family: var(--font-heading); font-size: 1.2rem; font-weight: 800; letter-spacing: -.01em; overflow-wrap: anywhere; }
  .ff__tip { margin: 0 0 12px; padding-left: 12px; border-left: 3px solid var(--color-accent, #e8682a); font-size: .95rem; }
  .ff__partner { margin: 0 0 14px; font-size: .88rem; color: var(--color-text-muted, #5d6270); }
  .ff__restart { display: block; margin: 12px auto 0; padding: 4px 8px; border: 0; background: none; color: var(--color-text-muted, #5d6270); font: inherit; font-size: .86rem; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  html:not(.js) .ff__card { display: none; }

  /* the bundle the finder picked gets a short glow in the buy box */
  .bundle.ff-flash { animation: ffFlash 1.6s var(--ease, ease); }
  @keyframes ffFlash { 0%, 100% { box-shadow: 0 0 0 1px var(--color-accent, #e8682a); } 30% { box-shadow: 0 0 0 1px var(--color-accent, #e8682a), 0 0 0 8px rgba(232, 104, 42, .25); } }
  @keyframes ffIn { from { opacity: 0; transform: translateX(14px); } }

  @media (max-width: 849px) { .ff__grid { grid-template-columns: minmax(0, 1fr); gap: 28px; } }
  @media (max-width: 479px) {
    .ff__card { padding: 20px 16px; }
    .ff__picks { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .ff__picks div:last-child { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) { .ff__step.is-active, .ff__result, .bundle.ff-flash { animation: none; } .ff__progress span { transition: none; } }
{% endstylesheet %}

{% javascript %}
  (function () {
    function init(card) {
      if (card.hasAttribute('data-ready')) return;
      card.setAttribute('data-ready', '');
      var steps = card.querySelectorAll('.ff__step');
      var result = card.querySelector('[data-ff-result]');
      var back = card.querySelector('[data-ff-back]');
      var count = card.querySelector('[data-ff-count]');
      var bar = card.querySelector('[data-ff-bar]');
      var answers = {};
      var current = 1;

      function product() {
        return document.querySelector('#buy [data-product]') || document.querySelector('#shop [data-product]') || document.querySelector('[data-product]');
      }
      function bundleCard(qty) {
        var root = product();
        var input = root && root.querySelector('.bundle__input[value="' + qty + '"]');
        return input ? input.closest('[data-bundle]') : null;
      }
      function show(n) {
        current = n;
        steps.forEach(function (s) { s.classList.toggle('is-active', s.getAttribute('data-step') == n); });
        result.hidden = n <= steps.length;
        back.hidden = n === 1;
        count.textContent = n <= steps.length ? n + ' / ' + steps.length : '✓';
        bar.style.width = Math.min(100, (n / steps.length) * 100) + '%';
        if (n > steps.length) fillResult();
      }
      function fillResult() {
        var b = bundleCard(answers.qty);
        var title = b ? b.querySelector('.bundle__title').firstChild.textContent.trim() : answers.qty + (answers.qty > 1 ? ' pairs' : ' pair');
        var price = b ? b.querySelector('[data-bundle-price]').textContent.trim() : '';
        card.querySelector('[data-ff-size]').textContent = answers.size;
        card.querySelector('[data-ff-bundle]').textContent = title;
        card.querySelector('[data-ff-price]').textContent = price || '—';
        card.querySelector('[data-ff-tip]').textContent = answers.tip || '';
        var partner = card.querySelector('[data-ff-partner]');
        if (partner) partner.hidden = !answers.partner;
      }
      function pick(input) {
        if (!input || input.checked) return;
        input.checked = true;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }

      card.addEventListener('click', function (e) {
        var opt = e.target.closest('.ff__opt');
        if (opt) {
          opt.parentNode.querySelectorAll('.ff__opt').forEach(function (o) { o.classList.toggle('is-picked', o === opt); });
          if (opt.hasAttribute('data-size')) answers.size = opt.getAttribute('data-size');
          if (opt.hasAttribute('data-qty')) { answers.qty = parseInt(opt.getAttribute('data-qty'), 10); answers.partner = opt.hasAttribute('data-partner'); }
          if (opt.hasAttribute('data-tip')) answers.tip = opt.getAttribute('data-tip');
          setTimeout(function () { show(current + 1); }, 180);
          return;
        }
        if (e.target.closest('[data-ff-back]')) { show(Math.max(1, current - 1)); return; }
        if (e.target.closest('[data-ff-restart]')) {
          answers = {};
          card.querySelectorAll('.is-picked').forEach(function (o) { o.classList.remove('is-picked'); });
          show(1);
          return;
        }
        if (e.target.closest('[data-ff-apply]')) {
          var root = product();
          if (!root) return;
          var sizeInput = Array.prototype.filter.call(root.querySelectorAll('[data-option-index] input'), function (i) { return i.value === answers.size; })[0];
          pick(sizeInput);
          var b = bundleCard(answers.qty);
          if (b) pick(b.querySelector('.bundle__input'));
          var target = b || root;
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          if (b) { b.classList.remove('ff-flash'); void b.offsetWidth; b.classList.add('ff-flash'); }
        }
      });
      show(1);
    }
    function boot(scope) { (scope || document).querySelectorAll('[data-fit-finder]').forEach(init); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { boot(); }); else boot();
    document.addEventListener('shopify:section:load', function (e) { boot(e.target); });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Fit finder",
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "alt" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "20-second fit finder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure which to pick? Three taps." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Answer three quick questions and we'll set up the buy box for you.</p>" },
    { "type": "text", "id": "perk_1", "label": "Point 1", "default": "Finds your size" },
    { "type": "text", "id": "perk_2", "label": "Point 2", "default": "Suggests the right bundle" },
    { "type": "text", "id": "perk_3", "label": "Point 3", "default": "Sets it all up in one tap" },
    { "type": "header", "content": "Question 1: size" },
    { "type": "text", "id": "q1", "label": "Question", "default": "What's your UK shoe size?" },
    { "type": "text", "id": "size_1_label", "label": "Answer 1", "default": "UK 3 – 7" },
    { "type": "text", "id": "size_1_value", "label": "Answer 1 size", "default": "S/M", "info": "Must match the product's size exactly." },
    { "type": "text", "id": "size_2_label", "label": "Answer 2", "default": "UK 7½ – 12" },
    { "type": "text", "id": "size_2_value", "label": "Answer 2 size", "default": "L/XL", "info": "Must match the product's size exactly." },
    { "type": "header", "content": "Question 2: bundle" },
    { "type": "text", "id": "q2", "label": "Question", "default": "Who's it for?" },
    { "type": "text", "id": "who_1", "label": "Answer: 1 pair", "default": "Just me" },
    { "type": "text", "id": "who_2", "label": "Answer: 2 pairs", "default": "Me, plus a spare for the wash or travel" },
    { "type": "text", "id": "who_3", "label": "Answer: 2 pairs (two people)", "default": "Me and my partner" },
    { "type": "text", "id": "who_4", "label": "Answer: 3 pairs", "default": "The whole household" },
    { "type": "text", "id": "partner_note", "label": "Note for two people", "default": "Different sizes? Pick each person's size in the 2-pair bundle." },
    { "type": "header", "content": "Question 3: tip" },
    { "type": "text", "id": "q3", "label": "Question", "default": "When do your legs play up?" },
    { "type": "text", "id": "when_1", "label": "Answer 1", "default": "As I'm dropping off" },
    { "type": "text", "id": "tip_1", "label": "Tip for answer 1", "default": "Put it on as you get into bed, so the pressure is there before your legs start." },
    { "type": "text", "id": "when_2", "label": "Answer 2", "default": "They wake me in the night" },
    { "type": "text", "id": "tip_2", "label": "Tip for answer 2", "default": "Keep it on all night. It's made to stay put when you turn over." },
    { "type": "text", "id": "when_3", "label": "Answer 3", "default": "Evenings on the sofa, too" },
    { "type": "text", "id": "tip_3", "label": "Tip for answer 3", "default": "Wear it on the sofa as well as in bed. It's low-profile enough for both." },
    { "type": "header", "content": "Result" },
    { "type": "text", "id": "result_heading", "label": "Heading", "default": "Our pick for you" },
    { "type": "text", "id": "apply_label", "label": "Button", "default": "Use these choices" },
    { "type": "text", "id": "restart_label", "label": "Start again link", "default": "Start again" }
  ],
  "presets": [{ "name": "Fit finder" }]
}
{% endschema %}
