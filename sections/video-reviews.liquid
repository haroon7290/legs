{%- comment -%}
  Video reviews: portrait customer videos with a quote and name, on a dark band.
  Only use real customer videos (with their permission). Cards scroll sideways on phones.
  Styles are included in this file, so it works on its own.
{%- endcomment -%}
<section class="section vr{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="vr__header reveal">
      {%- if section.settings.score != blank -%}
        <div class="vr__score">
          <span class="vr__score-value">{{ section.settings.score }}</span>
          <span>{% render 'stars', rating: section.settings.score %}{% if section.settings.score_text != blank %}<small>{{ section.settings.score_text }}</small>{% endif %}</span>
        </div>
      {%- endif -%}
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="vr__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="vr__text">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    </div>

    <div class="vr__track">
      {%- for block in section.blocks -%}
        <figure class="vr-card reveal" style="--d: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="vr-card__media">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: image_size: '600x', controls: true, muted: false, playsinline: true, preload: 'none' }}
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 70vw', widths: '300, 450, 600', alt: block.settings.name }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'vr-card__placeholder' }}
            {%- endif -%}
          </div>
          <figcaption class="vr-card__caption">
            {% render 'stars', rating: block.settings.rating %}
            {%- if block.settings.quote != blank -%}<p class="vr-card__quote">“{{ block.settings.quote }}”</p>{%- endif -%}
            <span class="vr-card__name">{{ block.settings.name }}{% if block.settings.verified %} <span class="vr-card__verified">{% render 'icon', icon: 'verified' %}</span>{% endif %}{% if block.settings.detail != blank %} · {{ block.settings.detail }}{% endif %}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="vr__cta reveal">
        <a href="{{ section.settings.button_link | default: '#buy' }}" class="button">{{ section.settings.button_label }} {% render 'icon', icon: 'arrow-right' %}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .vr__header { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 18px 40px; margin: 0 auto 44px; text-align: left; }
  .vr__score { display: flex; align-items: center; gap: 12px; }
  .vr__score-value { font-family: var(--font-heading); font-size: 3.4rem; font-weight: 800; line-height: 1; letter-spacing: -.04em; }
  .vr__score small { display: block; margin-top: 4px; font-size: .82rem; opacity: .7; }
  .vr__title { margin: 0 0 6px; }
  .vr__text { max-width: 560px; color: var(--color-text-muted, #5d6270); }
  .section--contrast .vr__text { color: var(--color-on-dark-muted, rgba(243, 237, 227, .66)); }
  .vr__track { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .vr-card { position: relative; margin: 0; overflow: hidden; border-radius: var(--radius-lg, 14px); background: var(--color-ink-2, #18233a); aspect-ratio: 9 / 16; box-shadow: 0 18px 40px -26px rgba(0, 0, 0, .7); transition: transform .4s var(--ease, ease); }
  .vr-card:hover { transform: translateY(-4px); }
  .vr-card__media, .vr-card__media video, .vr-card__media img, .vr-card__placeholder { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vr-card__placeholder { fill: rgba(243, 237, 227, .12); background: var(--color-ink-2, #18233a); }
  .vr-card__caption { position: absolute; left: 0; right: 0; bottom: 0; display: grid; gap: 6px; padding: 40px 16px 16px; background: linear-gradient(to top, rgba(7, 11, 19, .92), rgba(7, 11, 19, 0)); color: #f3ede3; pointer-events: none; }
  .vr-card__caption .stars svg { width: 13px; height: 13px; }
  .vr-card__quote { margin: 0; font-size: .9rem; font-weight: 600; line-height: 1.35; }
  .vr-card__name { font-size: .78rem; opacity: .8; }
  .vr-card__verified svg { display: inline; width: 12px; height: 12px; vertical-align: -1px; color: #6fcf97; }
  .vr__cta { margin-top: 36px; text-align: center; }
  @media (max-width: 989px) {
    .vr__track { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0 calc(var(--gutter, 16px) * -1); padding: 4px var(--gutter, 16px) 12px; scrollbar-width: none; }
    .vr__track::-webkit-scrollbar { display: none; }
    .vr-card { flex: 0 0 min(64vw, 260px); scroll-snap-align: start; }
    .vr__header { justify-content: flex-start; margin-bottom: 28px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video reviews",
  "max_blocks": 8,
  "settings": [
    { "type": "paragraph", "content": "Only use real customer videos, with their permission." },
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "contrast" },
    { "type": "text", "id": "score", "label": "Average rating", "info": "Your real average, e.g. 4.7. Leave empty to hide." },
    { "type": "text", "id": "score_text", "label": "Rating text", "info": "e.g. \"from 120 reviews\"" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real nights. Press play." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try it for 90 nights" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to scroll to the buy box." }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Customer video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Portrait (9:16) works best." },
        { "type": "image_picker", "id": "image", "label": "Photo (if no video)" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "quote", "label": "Quote", "info": "The customer's own words." },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
        { "type": "text", "id": "detail", "label": "Detail", "info": "e.g. town" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Video reviews", "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" }] }]
}
{% endschema %}
