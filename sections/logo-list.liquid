<section class="section section--tight" {{ section.shopify_attributes }}>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<p class="text-center muted" style="font-size:.85rem;letter-spacing:.14em;text-transform:uppercase;margin-bottom:20px">{{ section.settings.heading }}</p>{%- endif -%}
    <div class="logo-row">
      {%- for block in section.blocks -%}
        <span class="logo-row__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 300 | image_tag: alt: block.settings.text }}{%- else -%}{{ block.settings.text }}{%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Logo list",
  "max_blocks": 8,
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Loved by restless sleepers everywhere" }],
  "blocks": [
    { "type": "logo", "name": "Logo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Logo image" },
      { "type": "text", "id": "text", "label": "Text (if no image)", "default": "Brand" }
    ] }
  ],
  "presets": [{ "name": "Logo list", "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }] }]
}
{% endschema %}
