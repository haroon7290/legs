<section class="section{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" id="guarantee" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="guarantee reveal">
      <div class="guarantee__seal">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 400 | image_tag: alt: section.settings.heading }}
        {%- else -%}
          <img src="{{ 'guarantee-seal.svg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="170" height="170">
        {%- endif -%}
      </div>
      <div>
        <h2>{{ section.settings.heading }}</h2>
        <div class="guarantee__text rte">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#shop' }}" class="button">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.policy_link != blank -%}
          <a href="{{ section.settings.policy_link }}" class="link muted" style="margin-left:16px;font-size:.9rem">{{ 'general.read_policy' | t }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Background",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "alt",
          "label": "Alternate"
        },
        {
          "value": "contrast",
          "label": "Contrast (dark band)"
        }
      ],
      "default": "default"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Seal image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep on it for 90 nights."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Wear Legs Relief every night for at least 30 nights. If your legs aren't calmer, email us within 90 nights of delivery and we'll refund the pair you tried in full — you don't even have to send it back.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start my 90 nights"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "url",
      "id": "policy_link",
      "label": "Policy link"
    }
  ],
  "presets": [
    {
      "name": "Guarantee"
    }
  ]
}
{% endschema %}
