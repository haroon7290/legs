<div class="page-width error-page">
  <span class="site-header__logo" style="justify-content:center;font-size:2rem">{% render 'icon', icon: 'moon' %}{{ shop.name }}</span>
  <h2 style="margin-top:24px">{{ section.settings.heading }}</h2>
  <p class="muted">{{ shop.password_message }}</p>
  {%- form 'customer', class: 'newsletter-form', style: 'max-width:520px;margin:20px auto' -%}
    <input type="hidden" name="contact[tags]" value="prospect, password page">
    <input type="email" name="contact[email]" required placeholder="{{ 'general.email_placeholder' | t }}" aria-label="{{ 'general.email' | t }}">
    <button type="submit" class="button">{{ 'general.notify_me' | t }}</button>
  {%- endform -%}
  <details style="margin-top:30px">
    <summary class="muted" style="cursor:pointer">{{ 'general.store_owner' | t }}</summary>
    {%- form 'storefront_password', class: 'newsletter-form', style: 'max-width:520px;margin:16px auto' -%}
      <input type="password" name="password" placeholder="{{ 'general.password' | t }}" aria-label="{{ 'general.password' | t }}">
      <button type="submit" class="button">{{ 'general.enter' | t }}</button>
    {%- endform -%}
  </details>
</div>
{% schema %}
{ "name": "Password", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Calmer nights are coming soon" }] }
{% endschema %}
