<div class="page-width main-page">
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 9 -%}
    <div class="product-grid" style="--columns:3">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="card">
          <div class="card__media">{%- if article.image -%}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}<img src="{{ 'lifestyle.svg' | asset_url }}" alt="" loading="lazy" width="800" height="800">{%- endif -%}</div>
          <div class="card__body"><h2 class="card__title">{{ article.title }}</h2><p class="card__desc">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p></div>
        </a>
      {%- endfor -%}
    </div>
  {%- endpaginate -%}
</div>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
