<div class="page-width main-page">
  <h1>{{ blog.title }}</h1>
  {%- if blog.all_tags.size > 0 -%}
    <nav class="blog-tags" aria-label="{{ 'blogs.tags' | t }}">
      <a href="{{ blog.url }}" {% unless current_tags %}aria-current="page"{% endunless %}>{{ 'blogs.all' | t }}</a>
      {%- for tag in blog.all_tags -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" {% if current_tags contains tag %}aria-current="page"{% endif %}>{{ tag }}</a>
      {%- endfor -%}
    </nav>
  {%- endif -%}
  {%- paginate blog.articles by section.settings.per_page -%}
    <div class="product-grid" style="--columns:3">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="card">
          <div class="card__media">{%- if article.image -%}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: article.title, widths: '350, 500, 700', sizes: '(min-width: 990px) 33vw, 100vw' }}{%- else -%}<img src="{{ 'lifestyle.svg' | asset_url }}" alt="" loading="lazy" width="800" height="800">{%- endif -%}</div>
          <div class="card__body">
            <span class="muted" style="font-size:.82rem">{{ article.published_at | date: format: 'date' }}</span>
            <h2 class="card__title">{{ article.title }}</h2>
            <p class="card__desc">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
          </div>
        </a>
      {%- else -%}
        <p class="muted">{{ 'blogs.empty' | t }}</p>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>
{% schema %}
{ "name": "Blog", "settings": [{ "type": "range", "id": "per_page", "label": "Articles per page", "min": 3, "max": 24, "step": 3, "default": 9 }] }
{% endschema %}
