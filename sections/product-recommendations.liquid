{%- comment -%}
  Shows Shopify's product recommendations. The first render lists other products from
  the store so the section is never empty; theme.js then swaps in Shopify's
  recommendations from the Product Recommendations API when it returns results.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  assign shown = 0
-%}
<section class="section{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"
  {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ heading }}</h2>
    </div>
    <div class="product-grid product-grid--centered" data-recommendations-grid>
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for rec in recommendations.products -%}
          {% render 'product-card', product: rec %}
        {%- endfor -%}
      {%- else -%}
        {%- for item in collections.all.products -%}
          {%- if item.id != product.id and shown < section.settings.limit -%}
            {%- assign shown = shown | plus: 1 -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pairs well with" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete your night routine" },
    { "type": "select", "id": "intent", "label": "Recommendation type", "options": [{ "value": "related", "label": "Related" }, { "value": "complementary", "label": "Complementary (Search & Discovery app)" }], "default": "related" },
    { "type": "range", "id": "limit", "label": "Products", "min": 1, "max": 8, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
