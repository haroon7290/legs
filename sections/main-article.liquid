<article class="page-width page-width--narrow main-page article">
  <p class="text-center muted">{{ article.published_at | date: format: 'date' }}{% if section.settings.show_author %} · {{ article.author }}{% endif %}</p>
  <h1>{{ article.title }}</h1>
  {%- if article.image -%}
    <div class="article__image">{{ article.image | image_url: width: 1600 | image_tag: alt: article.title, widths: '600, 900, 1200, 1600', sizes: '(min-width: 860px) 860px, 100vw' }}</div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>

  {%- if article.tags.size > 0 -%}
    <div class="blog-tags" style="margin-top:32px">
      {%- for tag in article.tags -%}<a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>{%- endfor -%}
    </div>
  {%- endif -%}

  <p style="margin-top:40px"><a class="link" href="{{ blog.url }}">← {{ 'blogs.back' | t: title: blog.title }}</a></p>

  {%- if blog.comments_enabled? -%}
    <section class="article__comments" id="comments">
      <h2>{{ 'blogs.comments_heading' | t: count: article.comments_count }}</h2>
      {%- paginate article.comments by 10 -%}
        {%- for comment in article.comments -%}
          <div class="comment" id="{{ comment.id }}">
            <div class="rte">{{ comment.content }}</div>
            <p class="muted">{{ comment.author }} · {{ comment.created_at | date: format: 'date' }}</p>
          </div>
        {%- endfor -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}

      {%- form 'new_comment', article, class: 'form', id: 'CommentForm' -%}
        <h3>{{ 'blogs.leave_comment' | t }}</h3>
        {%- if form.posted_successfully? -%}
          <div class="notice" role="status">{% if blog.moderated? %}{{ 'blogs.comment_moderated' | t }}{% else %}{{ 'blogs.comment_posted' | t }}{% endif %}</div>
        {%- elsif form.errors -%}
          <div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="form__row">
          <div class="field"><label for="CommentAuthor">{{ 'contact.name' | t }} *</label><input type="text" id="CommentAuthor" name="comment[author]" value="{{ form.author }}" required autocomplete="name"></div>
          <div class="field"><label for="CommentEmail">{{ 'contact.email' | t }} *</label><input type="email" id="CommentEmail" name="comment[email]" value="{{ form.email }}" required autocomplete="email"></div>
        </div>
        <div class="field"><label for="CommentBody">{{ 'blogs.comment' | t }} *</label><textarea id="CommentBody" name="comment[body]" required>{{ form.body }}</textarea></div>
        {%- if blog.moderated? -%}<p class="muted" style="font-size:.85rem;margin:0">{{ 'blogs.moderated_note' | t }}</p>{%- endif -%}
        <button type="submit" class="button">{{ 'blogs.post' | t }}</button>
      {%- endform -%}
    </section>
  {%- endif -%}
</article>
{% schema %}
{ "name": "Article", "settings": [{ "type": "checkbox", "id": "show_author", "label": "Show author", "default": true }] }
{% endschema %}
