<div class="page-width cart-page">
  <h1 class="text-center">{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart-form">
      <div class="cart-page__grid">
        <div>
          {%- for item in cart.items -%}
            <div class="cart-item">
              <a href="{{ item.url }}" class="cart-item__image">
                {%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: alt: item.title }}{%- else -%}<img src="{{ 'product-pair-1.svg' | asset_url }}" alt="" width="84" height="84">{%- endif -%}
              </a>
              <div>
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<div class="cart-item__variant">{{ item.variant.title }}</div>{%- endunless -%}
                {%- for discount in item.line_level_discount_allocations -%}<div class="cart-item__variant" style="color:var(--color-success)">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</div>{%- endfor -%}
                <div class="qty">
                  <label class="visually-hidden" for="Qty-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label>
                  <input id="Qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:60px">
                </div>
                <div><a href="{{ item.url_to_remove }}" class="cart-item__remove">{{ 'cart.remove' | t }}</a></div>
              </div>
              <div class="cart-item__price">
                {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                {{ item.final_line_price | money }}
              </div>
            </div>
          {%- endfor -%}
          <button type="submit" name="update" class="button button--secondary button--small" style="margin-top:20px">{{ 'cart.update' | t }}</button>
        </div>
        <aside class="cart-page__summary">
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-savings"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          <div class="cart-totals"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
          <p class="cart-note-small" style="text-align:left">{% if cart.taxes_included %}{{ 'cart.taxes_included' | t }}{% else %}{{ 'cart.taxes_and_shipping' | t }}{% endif %}</p>
          {%- if section.settings.show_note -%}
            <label for="CartNote" style="font-size:.9rem;font-weight:600;display:block;margin-top:16px">{{ 'cart.note' | t }}</label>
            <textarea id="CartNote" name="note">{{ cart.note }}</textarea>
          {%- endif -%}
          <button type="submit" name="checkout" class="button button--full">{% render 'icon', icon: 'lock' %} {{ 'cart.checkout' | t }}</button>
          {%- if additional_checkout_buttons -%}<div style="margin-top:12px">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
          {% render 'payment-icons' %}
        </aside>
      </div>
    </form>
  {%- else -%}
    <div class="cart-empty">
      <p>{{ 'cart.empty_text' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Cart", "settings": [{ "type": "checkbox", "id": "show_note", "label": "Show order note", "default": false }] }
{% endschema %}
