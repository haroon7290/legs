<section class="section{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="problem reveal{% if section.settings.image_position == 'right' %} image-with-text--reverse{% endif %}">
      <div class="problem__media">
        {% render 'image', image: section.settings.image, fallback: section.settings.fallback_image, alt: section.settings.heading, sizes: '(min-width: 850px) 50vw, 100vw' %}
      </div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="rte{% if section.settings.style != 'contrast' %} muted{% endif %}">{{ section.settings.text }}</div>
        {%- if section.blocks.size > 0 -%}
          <ul class="problem__list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {%- if section.settings.list_style == 'negative' -%}{% render 'icon', icon: 'x-circle' %}{%- else -%}<span style="color:var(--color-success);display:flex">{% render 'icon', icon: 'check' %}</span>{%- endif -%}
                <span>{%- if block.settings.title != blank -%}<strong>{{ block.settings.title }}</strong> {% endif %}{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#shop' }}" class="button" style="margin-top:28px">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "max_blocks": 6,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_image", "label": "Dummy image asset", "default": "lifestyle.svg", "info": "Theme asset shown until you pick an image." },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sound familiar?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "It's 2am and your legs won't quit." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>You're exhausted, but the moment you lie still the creepy-crawly, have-to-move feeling starts. You stretch, you kick, you pace the hallway. Then you do it again tomorrow.</p>" },
    { "type": "select", "id": "list_style", "label": "List style", "options": [{ "value": "negative", "label": "Problems (✕)" }, { "value": "positive", "label": "Benefits (✓)" }], "default": "negative" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "item", "name": "List item", "settings": [
      { "type": "text", "id": "title", "label": "Bold text" },
      { "type": "text", "id": "text", "label": "Text", "default": "List item" }
    ] }
  ],
  "presets": [{ "name": "Image with text", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
