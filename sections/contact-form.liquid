<div class="page-width page-width--narrow main-page">
  <h1>{{ section.settings.heading | default: page.title }}</h1>
  {%- if section.settings.text != blank -%}<div class="rte text-center muted" style="margin:-16px auto 32px;max-width:600px">{{ section.settings.text }}</div>{%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="contact-cards">
      {%- for block in section.blocks -%}
        <div class="contact-card" {{ block.shopify_attributes }}>
          {% render 'icon', icon: block.settings.icon %}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if page.content != blank -%}<div class="rte" style="margin-bottom:28px">{{ page.content }}</div>{%- endif -%}
  {%- form 'contact', class: 'form', id: 'ContactForm' -%}
    {%- if form.posted_successfully? -%}
      <div class="notice" role="status">{{ 'contact.success' | t }}</div>
    {%- elsif form.errors -%}
      <div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="form__row">
      <div class="field"><label for="ContactName">{{ 'contact.name' | t }}</label><input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
      <div class="field"><label for="ContactEmail">{{ 'contact.email' | t }} *</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
    </div>
    <div class="field"><label for="ContactOrder">{{ 'contact.order' | t }}</label><input id="ContactOrder" type="text" name="contact[order]" placeholder="#1001"></div>
    <div class="field"><label for="ContactBody">{{ 'contact.message' | t }} *</label><textarea id="ContactBody" name="contact[body]" required>{{ form.body }}</textarea></div>
    <button type="submit" class="button">{{ 'contact.send' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Real people, real answers. We reply to every message within one working day.</p>" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Info card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "mail", "options": [{ "value": "mail", "label": "Mail" }, { "value": "clock", "label": "Clock" }, { "value": "chat", "label": "Chat" }, { "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Truck" }] },
        { "type": "text", "id": "title", "label": "Title", "default": "Email" },
        { "type": "text", "id": "text", "label": "Text", "default": "support@legrelief.co.uk" }
      ]
    }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
