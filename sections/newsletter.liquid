<section class="section{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="newsletter reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte muted">{{ section.settings.text }}</div>
      {%- form 'customer', class: 'newsletter-form', id: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">{{ 'general.email' | t }}</label>
        <input type="email" id="NewsletterEmail-{{ section.id }}" name="contact[email]" required autocomplete="email" placeholder="{{ 'general.email_placeholder' | t }}">
        <button type="submit" class="button">{{ section.settings.button_label }}</button>
        {%- if form.posted_successfully? -%}<p class="form-message form-message--success" style="flex-basis:100%">{{ 'general.newsletter_success' | t }}</p>{%- endif -%}
      {%- endform -%}
      {%- if section.settings.consent != blank -%}<div class="newsletter__consent rte">{{ section.settings.consent }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Better nights, in your inbox" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Sleep tips, wind-down routines and early access to new products. No spam — unsubscribe any time.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "richtext", "id": "consent", "label": "Small print", "default": "<p>By subscribing you agree to receive marketing emails from Legs Relief. Unsubscribe any time. See our <a href=\"/policies/privacy-policy\">privacy policy</a>.</p>" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
