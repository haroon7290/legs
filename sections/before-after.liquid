{%- comment -%}
  Before / after: two images side by side with labels, a short caption and a button.
  Uses dummy theme images until photos are added.
  Styles are included in this file, so it works on its own.
{%- endcomment -%}
<section class="section ba{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="ba__pair">
      {%- for side in (1..2) -%}
        {%- liquid
          if side == 1
            assign img = section.settings.image_before
            assign fallback = 'lifestyle.svg'
            assign label = section.settings.label_before
          else
            assign img = section.settings.image_after
            assign fallback = 'hero.svg'
            assign label = section.settings.label_after
          endif
        -%}
        <figure class="ba__item ba__item--{% if side == 1 %}before{% else %}after{% endif %} reveal" style="--d: {{ side }}">
          <div class="ba__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 440px, 50vw', widths: '400, 600, 900', alt: label }}
            {%- else -%}
              <img src="{{ fallback | asset_url }}" alt="{{ label | escape }}" loading="lazy" width="800" height="800">
            {%- endif -%}
          </div>
          {%- if label != blank -%}<figcaption class="ba__label">{{ label }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>

    <div class="ba__footer reveal">
      {%- if section.settings.caption_heading != blank -%}<p class="ba__caption-heading">{{ section.settings.caption_heading }}</p>{%- endif -%}
      {%- if section.settings.caption != blank -%}<div class="ba__caption">{{ section.settings.caption }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#buy' }}" class="button">{{ section.settings.button_label }} {% render 'icon', icon: 'arrow-right' %}</a>
      {%- endif -%}
      {%- if section.settings.note != blank -%}<p class="ba__note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .ba__pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; max-width: 900px; margin: 0 auto; }
  .ba__item { position: relative; margin: 0; }
  .ba__media { overflow: hidden; aspect-ratio: 4 / 5; border-radius: var(--radius-lg, 14px); background: var(--color-ink-2, #18233a); }
  .ba__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease, ease); }
  .ba__item.is-visible .ba__media img { transform: scale(1.03); }
  .ba__item--before .ba__media img { filter: saturate(.7) brightness(.85); }
  .ba__label { position: absolute; top: 14px; left: 14px; padding: 6px 12px; border-radius: 999px; background: rgba(7, 11, 19, .78); color: #f3ede3; font-size: .74rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; backdrop-filter: blur(4px); }
  .ba__item--after .ba__label { background: var(--color-accent, #e8682a); color: #fff; }
  .ba__footer { display: grid; justify-items: center; gap: 12px; max-width: 620px; margin: 36px auto 0; text-align: center; }
  .ba__caption-heading { margin: 0; font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; }
  .ba__caption { color: var(--color-text-muted, #5d6270); }
  .section--contrast .ba__caption { color: var(--color-on-dark-muted, rgba(243, 237, 227, .66)); }
  .ba__caption p { margin: 0; }
  .ba__footer .button { margin-top: 8px; }
  .ba__note { margin: 0; font-size: .8rem; opacity: .65; }
  @media (max-width: 749px) {
    .ba__pair { gap: 10px; }
    .ba__label { top: 10px; left: 10px; padding: 5px 9px; font-size: .64rem; }
  }
  @media (prefers-reduced-motion: reduce) { .ba__media img { transition: none; } .ba__item.is-visible .ba__media img { transform: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Before / after",
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "contrast" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Same bed. Same legs. A different night." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image_before", "label": "Before image" },
    { "type": "text", "id": "label_before", "label": "Before label", "default": "Before" },
    { "type": "image_picker", "id": "image_after", "label": "After image" },
    { "type": "text", "id": "label_after", "label": "After label", "default": "With Legs Relief" },
    { "type": "text", "id": "caption_heading", "label": "Caption heading" },
    { "type": "richtext", "id": "caption", "label": "Caption" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try it for 90 nights" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to scroll to the buy box." },
    { "type": "text", "id": "note", "label": "Small print", "default": "Illustration. Everyone is different." }
  ],
  "presets": [{ "name": "Before / after" }]
}
{% endschema %}
