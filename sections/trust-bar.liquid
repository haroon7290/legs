<div class="trust-bar" {{ section.shopify_attributes }}>
  <ul class="page-width trust-bar__list">
    {%- for block in section.blocks -%}
      <li class="trust-bar__item" {{ block.shopify_attributes }}>
        {% render 'icon', icon: block.settings.icon %}
        <span>{{ block.settings.title }}{% if block.settings.subtitle != blank %}<small>{{ block.settings.subtitle }}</small>{% endif %}</span>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Trust bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "moon-outline", "label": "Moon" }, { "value": "shield", "label": "Shield" },
          { "value": "leaf", "label": "Leaf" }, { "value": "pill", "label": "Pill" }, { "value": "heart", "label": "Heart" },
          { "value": "lock", "label": "Lock" }, { "value": "chat", "label": "Chat" }, { "value": "refresh", "label": "Returns" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "On every order" }
      ]
    }
  ],
  "presets": [{ "name": "Trust bar", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
