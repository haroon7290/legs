{%- comment -%}
  Timeline: what to expect, step by step (e.g. night 1, week 2, night 90), on a vertical line
  that fills in as the steps scroll into view.
  Styles are included in this file, so it works on its own.
{%- endcomment -%}
<section class="section tl{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <ol class="tl__list">
      {%- for block in section.blocks -%}
        <li class="tl-step reveal" {{ block.shopify_attributes }}>
          <span class="tl-step__dot" aria-hidden="true"></span>
          {%- if block.settings.label != blank -%}<span class="tl-step__label">{{ block.settings.label }}</span>{%- endif -%}
          <h3 class="tl-step__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="tl-step__text">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.button_label != blank or section.settings.note != blank -%}
      <div class="tl__footer reveal">
        {%- if section.settings.note != blank -%}<p class="tl__note">{{ section.settings.note }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#buy' }}" class="button">{{ section.settings.button_label }} {% render 'icon', icon: 'arrow-right' %}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .tl__list { position: relative; max-width: 680px; margin: 0 auto; padding: 0 0 0 40px; list-style: none; }
  .tl__list::before { content: ""; position: absolute; top: 8px; bottom: 8px; left: 9px; width: 2px; background: var(--line, rgba(19, 26, 38, .12)); }
  .section--contrast .tl__list::before { background: var(--line-dark, rgba(243, 237, 227, .14)); }
  .tl-step { position: relative; padding-bottom: 30px; }
  .tl-step:last-child { padding-bottom: 0; }
  .tl-step__dot { position: absolute; top: 3px; left: -40px; width: 20px; height: 20px; border-radius: 50%; background: var(--color-bg, #f4eee4); border: 2px solid var(--color-accent, #e8682a); transition: background-color .4s .3s; }
  .section--alt .tl-step__dot { background: var(--color-bg-alt, #ebe2d4); }
  .section--contrast .tl-step__dot { background: var(--color-ink, #0e1523); }
  .tl-step.is-visible .tl-step__dot { background: var(--color-accent, #e8682a); box-shadow: 0 0 0 5px rgba(232, 104, 42, .15); }
  .tl-step__label { display: block; margin-bottom: 4px; font-size: .74rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--color-accent, #e8682a); }
  .tl-step__title { margin: 0 0 6px; font-size: 1.18rem; }
  .tl-step__text { margin: 0; color: var(--color-text-muted, #5d6270); }
  .section--contrast .tl-step__text { color: var(--color-on-dark-muted, rgba(243, 237, 227, .66)); }
  .tl__footer { display: grid; justify-items: center; gap: 16px; max-width: 560px; margin: 40px auto 0; text-align: center; }
  .tl__note { margin: 0; font-size: .9rem; color: var(--color-text-muted, #5d6270); }
  .section--contrast .tl__note { color: var(--color-on-dark-muted, rgba(243, 237, 227, .66)); }
  @media (max-width: 749px) { .tl__list { padding-left: 34px; } .tl-step__dot { left: -34px; width: 18px; height: 18px; } .tl__list::before { left: 8px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Timeline",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What to expect" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "note", "label": "Note above the button" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to scroll to the buy box." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Night 1" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Timeline", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
