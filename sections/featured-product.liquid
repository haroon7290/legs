{%- assign product = section.settings.product -%}
{%- if product == blank -%}{%- assign product = all_products['legs-night-support-pair'] -%}{%- endif -%}
<section class="section{% if section.settings.style == 'alt' %} section--alt{% endif %}" id="shop" {{ section.shopify_attributes }}>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    {%- if product != blank -%}
      <div class="product" style="padding:0" data-product>
        <div class="product__media">{% render 'product-gallery', product: product, section: section %}</div>
        <div class="product__info">{% render 'product-info', product: product, section: section %}</div>
      </div>
    {%- else -%}
      <p class="text-center muted">{{ 'products.product.select_product' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
