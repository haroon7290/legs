{%- comment -%}
  Cards: a heading and a grid of cards. Three looks:
  - plain: label, title and text
  - icon: an icon beside the title
  - quote: the title is a question in quotes, the text answers it
  - flip: the question is on the front; tapping the card turns it over to the answer
  Optional pill badges, footnote and button underneath.
  Styles are included in this file, so it works on its own.
{%- endcomment -%}
<section class="section cg cg--{{ section.settings.card_style }}{% if section.settings.style == 'alt' %} section--alt{% elsif section.settings.style == 'contrast' %} section--contrast{% endif %}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="cg__grid" style="--cols: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- if section.settings.card_style == 'flip' -%}
          <div class="cg-card cg-card--flip reveal" style="--d: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <button type="button" class="cg-flip" aria-pressed="false" data-cg-flip>
              <span class="cg-flip__face cg-flip__front">
                {%- if block.settings.label != blank -%}<span class="cg-card__label">{{ block.settings.label }}</span>{%- endif -%}
                <span class="cg-card__title">“{{ block.settings.title }}”</span>
                <span class="cg-flip__hint">{% render 'icon', icon: 'refresh' %}{{ section.settings.flip_hint }}</span>
              </span>
              <span class="cg-flip__face cg-flip__back">
                <span class="cg-card__text">{{ block.settings.text }}</span>
                <span class="cg-flip__hint">{% render 'icon', icon: 'refresh' %}{{ section.settings.flip_back }}</span>
              </span>
            </button>
          </div>
          {%- continue -%}
        {%- endif -%}
        <div class="cg-card reveal" style="--d: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if section.settings.card_style == 'icon' and block.settings.icon != 'none' -%}
            <span class="cg-card__icon">{% render 'icon', icon: block.settings.icon %}</span>
          {%- endif -%}
          <div class="cg-card__body">
            {%- if block.settings.label != blank -%}<span class="cg-card__label">{{ block.settings.label }}</span>{%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="cg-card__title">{% if section.settings.card_style == 'quote' %}“{{ block.settings.title }}”{% else %}{{ block.settings.title }}{% endif %}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}<p class="cg-card__text">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.badge_1 != blank or section.settings.badge_2 != blank -%}
      <ul class="cg__badges reveal">
        {%- if section.settings.badge_1 != blank -%}<li>{% render 'icon', icon: 'tick' %}<span>{{ section.settings.badge_1 }}</span></li>{%- endif -%}
        {%- if section.settings.badge_2 != blank -%}<li>{% render 'icon', icon: 'tick' %}<span>{{ section.settings.badge_2 }}</span></li>{%- endif -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.footnote != blank or section.settings.button_label != blank -%}
      <div class="cg__footer reveal">
        {%- if section.settings.footnote != blank -%}<div class="cg__footnote">{{ section.settings.footnote }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#buy' }}" class="button">{{ section.settings.button_label }} {% render 'icon', icon: 'arrow-right' %}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .cg__grid { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: 16px; }
  .cg-card { display: flex; flex-direction: column; gap: 14px; padding: 24px 22px; border-radius: var(--radius-lg, 14px); background: var(--color-surface, #fbf8f3); border: 1px solid var(--line, rgba(19, 26, 38, .12)); transition: transform .35s var(--ease, ease), border-color .35s, box-shadow .35s; }
  .cg-card:hover { transform: translateY(-3px); border-color: rgba(232, 104, 42, .4); box-shadow: 0 14px 30px -22px rgba(14, 21, 35, .45); }
  .section--contrast .cg-card { background: var(--color-ink-2, #18233a); color: var(--color-on-dark, #f3ede3); border-color: var(--line-dark, rgba(243, 237, 227, .14)); }
  .cg-card__icon { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 50%; background: rgba(232, 104, 42, .12); color: var(--color-accent, #e8682a); }
  .cg-card__icon svg { width: 22px; height: 22px; }
  .cg-card__label { display: block; margin-bottom: 8px; font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--color-accent, #e8682a); }
  .cg-card__title { margin: 0 0 8px; font-size: 1.12rem; line-height: 1.25; }
  .cg-card__text { margin: 0; font-size: .94rem; color: var(--color-text-muted, #5d6270); }
  .section--contrast .cg-card__text { color: var(--color-on-dark-muted, rgba(243, 237, 227, .66)); }
  .cg--quote .cg-card { border-top: 3px solid var(--color-accent, #e8682a); }
  .cg--quote .cg-card__title { font-size: 1.08rem; }
  .cg__badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 28px 0 0; padding: 0; list-style: none; }
  .cg__badges li { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 999px; background: var(--color-ink, #0e1523); color: var(--color-on-dark, #f3ede3); font-size: .86rem; font-weight: 600; }
  .cg__badges svg { width: 15px; height: 15px; color: var(--color-accent, #e8682a); }
  .cg__footer { display: grid; justify-items: center; gap: 18px; max-width: 640px; margin: 30px auto 0; text-align: center; }
  .cg__footnote { color: var(--color-text-muted, #5d6270); }
  .section--contrast .cg__footnote { color: var(--color-on-dark-muted, rgba(243, 237, 227, .66)); }
  .cg__footnote p { margin: 0; }
  /* Flip cards */
  .cg-card--flip { padding: 0; border: 0; background: none; perspective: 1200px; }
  .cg-card--flip:hover { border-color: transparent; box-shadow: none; }
  .cg-flip { display: grid; width: 100%; height: 100%; min-height: 210px; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; transform-style: preserve-3d; transition: transform .7s cubic-bezier(.3, .7, .2, 1); }
  .cg-flip:focus-visible { outline: 2px solid var(--color-accent, #e8682a); outline-offset: 3px; border-radius: var(--radius-lg, 14px); }
  .cg-flip.is-flipped { transform: rotateY(180deg); }
  .cg-flip__face { grid-area: 1 / 1; display: flex; flex-direction: column; gap: 10px; padding: 24px 22px 20px; border-radius: var(--radius-lg, 14px); -webkit-backface-visibility: hidden; backface-visibility: hidden; }
  .cg-flip__front { background: var(--color-surface, #fbf8f3); border: 1px solid var(--line, rgba(19, 26, 38, .12)); border-top: 3px solid var(--color-accent, #e8682a); }
  .cg-flip__front .cg-card__title { font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; line-height: 1.25; letter-spacing: -.01em; }
  .cg-flip__back { background: var(--color-ink, #0e1523); color: var(--color-on-dark, #f3ede3); transform: rotateY(180deg); }
  .cg-flip__back .cg-card__text { color: var(--color-on-dark, #f3ede3); font-size: 1rem; }
  .cg-flip__hint { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 8px; font-size: .8rem; font-weight: 600; color: var(--color-text-muted, #5d6270); }
  .cg-flip__back .cg-flip__hint { color: var(--color-on-dark-muted, rgba(243, 237, 227, .66)); }
  .cg-flip__hint svg { width: 14px; height: 14px; color: var(--color-accent, #e8682a); }
  .section--contrast .cg-flip__front { background: var(--color-ink-2, #18233a); border-color: var(--line-dark, rgba(243, 237, 227, .14)); }
  @media (prefers-reduced-motion: reduce) {
    .cg-flip { transition: none; transform: none !important; }
    .cg-flip__back { transform: none; visibility: hidden; }
    .cg-flip.is-flipped .cg-flip__back { visibility: visible; }
    .cg-flip.is-flipped .cg-flip__front { visibility: hidden; }
  }
  @media (max-width: 989px) { .cg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 599px) {
    .cg__grid { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .cg--icon .cg-card { flex-direction: row; align-items: flex-start; padding: 18px; }
    .cg--icon .cg-card__icon { flex-shrink: 0; width: 40px; height: 40px; }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function (e) {
    var card = e.target.closest('[data-cg-flip]');
    if (!card) return;
    var flipped = card.classList.toggle('is-flipped');
    card.setAttribute('aria-pressed', flipped);
  });
{% endjavascript %}

{% schema %}
{
  "name": "Cards",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "contrast", "label": "Contrast (dark band)" }], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cards" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "card_style", "label": "Card style", "options": [{ "value": "plain", "label": "Label and text" }, { "value": "icon", "label": "With icon" }, { "value": "quote", "label": "Question in quotes" }, { "value": "flip", "label": "Flip cards (question / answer)" }], "default": "plain" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "flip_hint", "label": "Flip card hint", "default": "Tap for the answer" },
    { "type": "text", "id": "flip_back", "label": "Flip back hint", "default": "Tap to turn back" },
    { "type": "text", "id": "badge_1", "label": "Badge 1" },
    { "type": "text", "id": "badge_2", "label": "Badge 2" },
    { "type": "richtext", "id": "footnote", "label": "Text under the cards" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to scroll to the buy box." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon (With icon style)", "default": "moon-outline", "options": [{ "value": "none", "label": "None" }, { "value": "moon-outline", "label": "Moon" }, { "value": "leaf", "label": "Leaf" }, { "value": "heart", "label": "Heart" }, { "value": "clock", "label": "Clock" }, { "value": "feet", "label": "Feet" }, { "value": "compress", "label": "Pressure" }, { "value": "shield", "label": "Shield" }, { "value": "pill", "label": "Pill" }, { "value": "washing", "label": "Washable" }, { "value": "truck", "label": "Truck" }, { "value": "chat", "label": "Chat" }] },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A short line about this." }
      ]
    }
  ],
  "presets": [{ "name": "Cards", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
