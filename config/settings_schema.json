  {
    "name": "Typography",
    "settings": [
      {
        "type": "checkbox",
        "id": "use_google_fonts",
        "label": "Use brand fonts (Archivo + Figtree)",
        "default": true,
        "info": "Loaded from Google Fonts. Untick to use the font pickers below."
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Headings (when brand fonts are off)",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body (when brand fonts are off)",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "radius",
        "label": "Corner radius",
        "min": 4,
        "max": 28,
        "step": 2,
        "unit": "px",
        "default": 10
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free shipping bar threshold",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "$",
        "default": 0,
        "info": "0 hides the progress bar (shipping is already free)."
      },
      {
        "type": "product",
        "id": "cart_upsell_product",
        "label": "Cart upsell product"
      },
      {
        "type": "text",
        "id": "cart_upsell_heading",
        "label": "Upsell heading",
        "default": "Add the eBook to your night routine"
      },
      {
        "type": "text",
        "id": "cart_guarantee_text",
        "label": "Text under checkout button",
        "default": "Free UK delivery · 90-night guarantee"
      }
    ]
  },
  {
    "name": "Reviews",
    "settings": [
      {
        "type": "paragraph",
        "content": "Star ratings show automatically once a reviews app (for example Judge.me or Shopify Product Reviews) has real reviews for a product. Nothing is shown until then."
