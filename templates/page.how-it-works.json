        "step_1": {
          "type": "step",
          "settings": {
            "icon": "auto",
            "title": "Wrap it under the arch",
            "text": "Start with the band under your arch, then bring it across the top of your foot so it crosses in an X.",
            "note": "Takes about 10 seconds"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "icon": "auto",
            "title": "Make it snug",
            "text": "Pull it firm and press the end flat. You want steady pressure: snug, never tight or tingly.",
            "note": "Snug, not tight"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "icon": "auto",
            "title": "Lie back and sleep",
            "text": "Get into bed as usual. The steady pressure under your arch stays with you through the night.",
            "note": "Stays put until morning"
          }
        }
      },
