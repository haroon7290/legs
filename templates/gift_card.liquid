{% layout none %}
{%- liquid
  assign initial_value = gift_card.initial_value | money
  assign expires_on = gift_card.expires_on | date: format: 'date'
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_cards.issued.title' | t: value: initial_value }} &ndash; {{ shop.name }}</title>
    {%- if settings.use_google_fonts -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
    {%- endif -%}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="gift-card-page">
    <main class="page-width page-width--narrow gift-card">
      <a href="{{ routes.root_url }}" class="site-header__logo gift-card__logo">{% render 'icon', icon: 'logo-mark' %}{% render 'logo-text' %}</a>
      <h1>{{ 'gift_cards.issued.heading' | t }}</h1>
      <div class="gift-card__card">
        <span class="gift-card__value">{{ gift_card.balance | money }}</span>
        {%- if gift_card.balance != gift_card.initial_value -%}
          <span class="muted">{{ 'gift_cards.issued.initial_value' | t: value: initial_value }}</span>
        {%- endif -%}
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="notice notice--error">{% if gift_card.expired %}{{ 'gift_cards.issued.expired' | t: expiry: expires_on }}{% else %}{{ 'gift_cards.issued.disabled' | t }}{% endif %}</p>
        {%- elsif gift_card.expires_on -%}
          <p class="muted">{{ 'gift_cards.issued.expires_on' | t: expires_on: expires_on }}</p>
        {%- endif -%}
        <div class="gift-card__code">
          <input type="text" id="GiftCardCode" value="{{ gift_card.code | format_code }}" readonly aria-label="{{ 'gift_cards.issued.code' | t }}">
          <button type="button" class="button button--small" data-copy="{{ gift_card.code | format_code }}">{{ 'gift_cards.issued.copy' | t }}</button>
        </div>
        <div id="GiftCardQr" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
      </div>
      <div class="gift-card__actions">
        <a href="{{ shop.url }}" class="button">{{ 'gift_cards.issued.shop_link' | t }}</a>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="button button--secondary">{{ 'gift_cards.issued.add_to_apple_wallet' | t }}</a>
        {%- endif -%}
      </div>
    </main>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var qr = document.getElementById('GiftCardQr');
        if (qr && window.QRCode) new QRCode(qr, { text: qr.getAttribute('data-identifier'), width: 140, height: 140 });
        document.querySelectorAll('[data-copy]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var done = function () { btn.textContent = {{ 'gift_cards.issued.copied' | t | json }}; };
            if (navigator.clipboard) navigator.clipboard.writeText(btn.getAttribute('data-copy')).then(done, function () { document.getElementById('GiftCardCode').select(); });
            else { document.getElementById('GiftCardCode').select(); }
          });
        });
      });
    </script>
  </body>
</html>
