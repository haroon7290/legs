<div class="page-width" style="max-width:480px;padding:64px var(--gutter)">
  <h1 class="text-center">{{ 'customer.reset' | t }}</h1>
  {%- form 'reset_customer_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ResetPassword">{{ 'general.password' | t }}</label><input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ResetPasswordConfirm">{{ 'customer.confirm_password' | t }}</label><input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="button button--full">{{ 'customer.reset' | t }}</button>
  {%- endform -%}
</div>
