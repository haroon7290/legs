<div class="page-width" style="max-width:480px;padding:64px var(--gutter)">
  <h1 class="text-center">{{ 'customer.login' | t }}</h1>
  <div id="recover" style="display:none">
    {%- form 'recover_customer_password', class: 'form' -%}
      {%- if form.posted_successfully? -%}<div class="notice">{{ 'customer.recover_success' | t }}</div>{%- endif -%}
      {{ form.errors | default_errors }}
      <div class="field"><label for="RecoverEmail">{{ 'contact.email' | t }}</label><input type="email" id="RecoverEmail" name="email" required></div>
      <button class="button button--full">{{ 'customer.reset' | t }}</button>
      <a href="#login" class="link muted text-center" onclick="document.getElementById('recover').style.display='none';document.getElementById('login').style.display='block'">{{ 'general.cancel' | t }}</a>
    {%- endform -%}
  </div>
  <div id="login">
    {%- form 'customer_login', class: 'form' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label for="LoginEmail">{{ 'contact.email' | t }}</label><input type="email" id="LoginEmail" name="customer[email]" autocomplete="email" required></div>
      <div class="field"><label for="LoginPassword">{{ 'general.password' | t }}</label><input type="password" id="LoginPassword" name="customer[password]" autocomplete="current-password" required></div>
      <a href="#recover" class="link muted" onclick="document.getElementById('recover').style.display='block';document.getElementById('login').style.display='none'">{{ 'customer.forgot' | t }}</a>
      <button class="button button--full">{{ 'customer.sign_in' | t }}</button>
      <a href="{{ routes.account_register_url }}" class="link text-center">{{ 'customer.create' | t }}</a>
    {%- endform -%}
  </div>
</div>
