<div class="page-width" style="max-width:480px;padding:64px var(--gutter)">
  <h1 class="text-center">{{ 'customer.create' | t }}</h1>
  {%- form 'create_customer', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="RegFirst">{{ 'customer.first_name' | t }}</label><input type="text" id="RegFirst" name="customer[first_name]" autocomplete="given-name"></div>
    <div class="field"><label for="RegLast">{{ 'customer.last_name' | t }}</label><input type="text" id="RegLast" name="customer[last_name]" autocomplete="family-name"></div>
    <div class="field"><label for="RegEmail">{{ 'contact.email' | t }}</label><input type="email" id="RegEmail" name="customer[email]" autocomplete="email" required></div>
    <div class="field"><label for="RegPassword">{{ 'general.password' | t }}</label><input type="password" id="RegPassword" name="customer[password]" autocomplete="new-password" required></div>
    <button class="button button--full">{{ 'customer.create' | t }}</button>
  {%- endform -%}
</div>
