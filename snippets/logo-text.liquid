{%- comment -%} Store name with everything after the first word set in the accent serif. {%- endcomment -%}
{%- assign name_parts = shop.name | split: ' ' -%}
<span>{{ name_parts.first }}{% if name_parts.size > 1 %} <em>{% for part in name_parts offset: 1 %}{{ part }}{% unless forloop.last %} {% endunless %}{% endfor %}</em>{% endif %}</span>
