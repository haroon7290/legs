{%- comment -%}
  Renders a Shopify image, or a theme asset as a dummy fallback.
  Usage: {% render 'image', image: section.settings.image, fallback: 'hero.svg', alt: 'text', sizes: '50vw', loading: 'lazy' %}
{%- endcomment -%}
{%- if image != blank -%}
  {{ image | image_url: width: 1600 | image_tag: loading: loading, sizes: sizes, widths: '400, 600, 800, 1000, 1200, 1600', alt: image.alt | default: alt }}
{%- elsif fallback != blank -%}
  <img src="{{ fallback | asset_url }}" alt="{{ alt | escape }}" loading="{{ loading | default: 'lazy' }}" width="800" height="800">
{%- else -%}
  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
{%- endif -%}
