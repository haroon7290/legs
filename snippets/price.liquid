{%- comment -%}
  Usage: {% render 'price', product: product, variant: variant, show_badge: true %}
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  assign on_sale = false
  if compare > price
    assign on_sale = true
    assign saving_pct = compare | minus: price | times: 100.0 | divided_by: compare | round
  endif
-%}
<div class="price">
  <span class="price__current" data-price>{{ price | money }}</span>
  <s class="price__compare" data-compare-price {% unless on_sale %}hidden{% endunless %}>{% if on_sale %}{{ compare | money }}{% endif %}</s>
  {%- if show_badge -%}
    <span class="price__save" data-save-badge {% unless on_sale %}hidden{% endunless %}>{% if on_sale %}{{ 'products.product.save_percent' | t: percent: saving_pct }}{% endif %}</span>
  {%- endif -%}
</div>
