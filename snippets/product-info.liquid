{%- comment -%}
  Product buy box. Renders section.blocks in order.
  Usage: {% render 'product-info', product: product, section: section %}
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign rating = product.metafields.reviews.rating.value.rating | default: settings.default_rating
  assign rating_count = product.metafields.reviews.rating_count | default: settings.default_rating_count
  assign form_id = 'product-form-' | append: section.id
-%}

<script type="application/json" data-product-json>
  {
    "id": {{ product.id }},
    "variants": [
      {%- for v in product.variants -%}
        {
          "id": {{ v.id }},
          "title": {{ v.title | json }},
          "options": {{ v.options | json }},
          "price": {{ v.price }},
          "compare_at_price": {{ v.compare_at_price | default: 0 }},
          "available": {{ v.available | json }},
          "featured_media_id": {{ v.featured_media.id | default: 'null' }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{%- for block in section.blocks -%}
  {%- case block.type -%}

    {%- when 'rating' -%}
      <div class="rating-line" {{ block.shopify_attributes }}>
        {% render 'stars', rating: rating %}
        <span><strong>{{ rating }}</strong> · {{ block.settings.text | replace: '[count]', rating_count }}</span>
      </div>

    {%- when 'title' -%}
      {%- if section.settings.link_title -%}
        <h2 class="product__title" {{ block.shopify_attributes }}><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
      {%- else -%}
        <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
      {%- endif -%}

    {%- when 'subtitle' -%}
      <p class="product__subtitle" {{ block.shopify_attributes }}>{{ product.metafields.custom.subtitle | default: block.settings.text }}</p>

    {%- when 'price' -%}
      <div class="product__price" {{ block.shopify_attributes }}>
        {% render 'price', product: product, variant: current_variant, show_badge: true %}
        {%- if block.settings.note != blank -%}<p class="muted" style="margin:8px 0 0;font-size:.88rem">{{ block.settings.note }}</p>{%- endif -%}
      </div>

    {%- when 'benefits' -%}
      <ul class="product__benefits" {{ block.shopify_attributes }}>
        {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
        {%- for line in lines -%}
          {%- assign l = line | strip -%}
          {%- if l != blank -%}<li>{% render 'icon', icon: 'check' %}<span>{{ l }}</span></li>{%- endif -%}
        {%- endfor -%}
      </ul>

    {%- when 'description' -%}
      <div class="rte muted" style="margin-bottom:22px" {{ block.shopify_attributes }}>{{ product.description }}</div>

    {%- when 'text' -%}
      <div class="rte" style="margin-bottom:18px" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

    {%- when 'variant_picker' -%}
      {%- unless product.has_only_default_variant -%}
        <div {{ block.shopify_attributes }}>
          {%- for option in product.options_with_values -%}
            {%- assign opt_index = forloop.index0 -%}
            <fieldset class="option-group" data-option-index="{{ opt_index }}">
              <legend>
                <span style="font-weight:700;color:inherit">{{ option.name }}: <span data-selected-option="{{ opt_index }}">{{ option.selected_value }}</span></span>
                {%- if block.settings.show_size_guide and forloop.first -%}
                  <button type="button" class="size-guide-link" data-modal-open="size-guide-{{ section.id }}">{{ 'products.product.size_guide' | t }}</button>
                {%- endif -%}
              </legend>
              <div class="option-pills">
                {%- for value in option.values -%}
                  {%- assign input_id = section.id | append: '-' | append: opt_index | append: '-' | append: forloop.index0 -%}
                  <input type="radio" id="{{ input_id }}" name="option-{{ section.id }}-{{ opt_index }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                  <label for="{{ input_id }}">{{ value }}</label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        </div>
        {%- if block.settings.show_size_guide -%}
          <div class="modal" id="size-guide-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'products.product.size_guide' | t }}">
            <div class="modal__overlay" data-drawer-close></div>
            <div class="modal__content">
              <button type="button" class="icon-button modal__close" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', icon: 'close' %}</button>
              <h3>{{ 'products.product.size_guide' | t }}</h3>
              <div class="rte">{{ block.settings.size_guide }}</div>
            </div>
          </div>
        {%- endif -%}
      {%- endunless -%}

    {%- when 'quantity_breaks' -%}
      {%- liquid
        assign gift = block.settings.gift_product
        if gift == blank or gift.available == false or gift.id == product.id
          assign gift = nil
        endif
        assign unit_label = block.settings.unit_label | default: 'item'
        assign unit_title = unit_label | capitalize
        assign show_units = false
        if block.settings.mix_variants and product.has_only_default_variant == false
          assign show_units = true
        endif
        assign option_name = product.options_with_values.first.name | downcase
        assign gift_is_ebook = false
        if gift.type == 'eBook' or gift.handle contains 'ebook'
          assign gift_is_ebook = true
        endif
      -%}
      <fieldset class="option-group bundles-block" data-bundles {{ block.shopify_attributes }}>
        <legend>
          {{ block.settings.heading }}
          {%- if block.settings.note != blank -%}<span class="bundles__note">{% render 'icon', icon: 'truck' %}{{ block.settings.note }}</span>{%- endif -%}
        </legend>
        <div class="bundles">
          {%- for i in (1..3) -%}
            {%- liquid
              assign q_key = 'qty_' | append: i
              assign qty = block.settings[q_key]
              if qty == 0
                continue
              endif
              assign t_key = 'title_' | append: i
              assign s_key = 'sub_' | append: i
              assign d_key = 'discount_' | append: i
              assign g_key = 'tag_' | append: i
              assign f_key = 'gift_' | append: i
              assign discount = block.settings[d_key]
              assign tag = block.settings[g_key]
              assign has_gift = false
              if gift and block.settings[f_key]
                assign has_gift = true
              endif
              assign factor = 100 | minus: discount
              assign tier_price = current_variant.price | times: qty | times: factor | divided_by: 100.0 | round
              assign tier_compare = current_variant.compare_at_price | default: current_variant.price | times: qty
              assign tier_save = tier_compare | minus: tier_price
              assign tier_unit = tier_price | divided_by: qty
              assign bundle_id = section.id | append: '-bundle-' | append: i
            -%}
            <div class="bundle{% if i == block.settings.default_tier %} is-selected{% endif %}{% if tag != blank %} bundle--tagged{% endif %}" style="--i: {{ forloop.index0 }}" data-bundle>
              <input class="bundle__input" type="radio" id="{{ bundle_id }}" name="bundle-{{ section.id }}" value="{{ qty }}" data-discount="{{ discount }}" data-gift="{{ has_gift }}" {% if i == block.settings.default_tier %}checked{% endif %}>
              <label class="bundle__main{% unless block.settings.show_images %} bundle__main--plain{% endunless %}" for="{{ bundle_id }}">
                {%- if tag != blank -%}<span class="bundle__tag{% if i == 2 %} bundle__tag--accent{% endif %}">{{ tag }}</span>{%- endif -%}
                <span class="bundle__radio" aria-hidden="true"></span>
                {%- if block.settings.show_images -%}
                  <span class="bundle__thumbs" aria-hidden="true">
                    {%- for n in (1..qty) limit: 3 -%}
                      <span class="bundle__thumb" style="--n: {{ forloop.index0 }}">
                        {%- if product.featured_media -%}
                          {{ product.featured_media | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', width: 56, height: 56 }}
                        {%- else -%}
                          <img src="{{ 'product-pair-1.svg' | asset_url }}" alt="" width="56" height="56" loading="lazy">
                        {%- endif -%}
                      </span>
                    {%- endfor -%}
                    {%- if qty > 1 -%}<span class="bundle__count">×{{ qty }}</span>{%- endif -%}
                  </span>
                {%- endif -%}
                <span class="bundle__text">
                  <span class="bundle__title">
                    {{ block.settings[t_key] }}
                    {%- if block.settings.show_savings and discount > 0 -%}<span class="bundle__save">Save <span data-bundle-save>{{ tier_save | money }}</span></span>{%- endif -%}
                  </span>
                  {%- if block.settings[s_key] != blank -%}<span class="bundle__sub">{{ block.settings[s_key] }}</span>{%- endif -%}
                  {%- if block.settings.show_unit_price and qty > 1 -%}<span class="bundle__unit"><strong data-bundle-unit>{{ tier_unit | money }}</strong> / {{ unit_label }}</span>{%- endif -%}
                </span>
                <span class="bundle__price">
                  <span class="bundle__now" data-bundle-price>{{ tier_price | money }}</span>
                  {%- if tier_compare > tier_price -%}<s class="bundle__was" data-bundle-compare>{{ tier_compare | money }}</s>{%- endif -%}
                </span>
                {%- if has_gift -%}
                  <span class="bundle__gift">
                    <span class="bundle__gift-media" aria-hidden="true">
                      {%- if gift.featured_media -%}
                        {{ gift.featured_media | image_url: width: 80 | image_tag: alt: '', loading: 'lazy', width: 24, height: 32 }}
                      {%- elsif gift_is_ebook -%}
                        <img src="{{ 'ebook-cover.svg' | asset_url }}" alt="" width="24" height="32" loading="lazy">
                      {%- else -%}
                        {% render 'icon', icon: 'heart' %}
                      {%- endif -%}
                    </span>
                    <span class="bundle__gift-text">+ <strong>{{ block.settings.gift_label }}</strong> {{ gift.title }}</span>
                    {%- if gift.price > 0 -%}<s class="bundle__gift-was">{{ gift.price | money }}</s>{%- endif -%}
                  </span>
                {%- endif -%}
              </label>
              {%- if show_units and qty > 1 -%}
                <div class="bundle__units">
                  <div class="bundle__units-inner">
                    <div class="bundle__units-body">
                      <p class="bundle__units-title">Choose a {{ option_name }} for each {{ unit_label }}</p>
                      <div class="bundle__units-grid">
                        {%- for n in (1..qty) -%}
                          {%- assign unit_id = bundle_id | append: '-unit-' | append: n -%}
                          <div class="bundle__unit-field">
                            <label for="{{ unit_id }}">{{ unit_title }} {{ n }}</label>
                            <select id="{{ unit_id }}" data-bundle-unit-select>
                              {%- for v in product.variants -%}
                                <option value="{{ v.id }}"{% if v.id == current_variant.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title }}</option>
                              {%- endfor -%}
                            </select>
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if gift -%}<input type="hidden" value="{{ gift.selected_or_first_available_variant.id }}" data-bundle-gift>{%- endif -%}
      </fieldset>

    {%- when 'stock' -%}
      <div class="stock-note" {{ block.shopify_attributes }}><span class="stock-note__dot"></span><span>{{ block.settings.text }}</span></div>

    {%- when 'delivery' -%}
      {%- assign min_secs = block.settings.min_days | times: 86400 -%}
      {%- assign max_secs = block.settings.max_days | times: 86400 -%}
      {%- assign now_secs = 'now' | date: '%s' | times: 1 -%}
      {%- assign min_date = now_secs | plus: min_secs | date: '%b %-d' -%}
      {%- assign max_date = now_secs | plus: max_secs | date: '%b %-d' -%}
      <div class="delivery-note" {{ block.shopify_attributes }}>
        {% render 'icon', icon: 'truck' %}
        <span>{{ block.settings.text | replace: '[min]', min_date | replace: '[max]', max_date }}</span>
      </div>

    {%- when 'addon' -%}
      {%- assign addon = block.settings.product -%}
      {%- if addon != blank and addon.available and addon.id != product.id -%}
        <label class="bundle" style="grid-template-columns:auto 1fr auto;margin-bottom:18px" {{ block.shopify_attributes }}>
          <input type="checkbox" value="{{ addon.selected_or_first_available_variant.id }}" data-addon style="position:static;opacity:1;pointer-events:auto;width:20px;height:20px;accent-color:var(--color-accent)">
          <span>
            <span class="bundle__title">{{ block.settings.label | default: addon.title }}</span>
            <span class="bundle__sub" style="display:block">{{ block.settings.subtext }}</span>
          </span>
          <span class="bundle__price">{% if addon.compare_at_price > addon.price %}<s>{{ addon.compare_at_price | money }}</s>{% endif %}{{ addon.price | money }}</span>
        </label>
      {%- endif -%}

    {%- when 'buy_buttons' -%}
      {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <div class="product-form__buttons" {{ block.shopify_attributes }}>
          <button type="submit" class="button button--full" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
            <span data-add-to-cart-text>{% if current_variant.available %}{% if block.settings.label != blank %}{{ block.settings.label }}{% else %}{{ 'products.product.add_to_cart' | t }}{% endif %}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
          </button>
          {%- if block.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
        </div>
        <p class="product-form__error" data-form-error hidden role="alert"></p>
      {%- endform -%}
      {%- if block.settings.show_payment_icons -%}{% render 'payment-icons' %}{%- endif -%}

    {%- when 'assurance' -%}
      <div class="product__assurance" {{ block.shopify_attributes }}>
        <div>{% render 'icon', icon: 'truck' %}{{ block.settings.item_1 }}</div>
        <div>{% render 'icon', icon: 'moon-outline' %}{{ block.settings.item_2 }}</div>
        <div>{% render 'icon', icon: 'lock' %}{{ block.settings.item_3 }}</div>
      </div>

    {%- when 'mini_review' -%}
      <div class="mini-review" {{ block.shopify_attributes }}>
        {% render 'stars', rating: 5 %}
        <p>“{{ block.settings.quote }}”</p>
        <strong>— {{ block.settings.author }}</strong> <span class="verified">{% render 'icon', icon: 'verified' %} {{ 'general.verified' | t }}</span>
      </div>

    {%- when 'collapsible' -%}
      <div class="accordion" style="margin-top:0;border-top:0" {{ block.shopify_attributes }}>
        <details {% if block.settings.open %}open{% endif %}>
          <summary>{{ block.settings.heading }} {% render 'icon', icon: 'chevron-down' %}</summary>
          <div class="accordion__content rte">
            {%- if block.settings.use_description -%}{{ product.description }}{%- else -%}{{ block.settings.content }}{%- endif -%}
          </div>
        </details>
      </div>
    {%- when 'quantity' -%}
      <div class="option-group quantity-picker" {{ block.shopify_attributes }}>
        <label class="option-group__label" for="Quantity-{{ section.id }}">{{ 'cart.quantity' | t }}</label>
        <div class="qty qty--large">
          <button type="button" data-qty-step="-1" aria-label="{{ 'cart.decrease' | t }}">−</button>
          <input type="number" id="Quantity-{{ section.id }}" min="1" value="1" data-quantity-input>
          <button type="button" data-qty-step="1" aria-label="{{ 'cart.increase' | t }}">+</button>
        </div>
      </div>

    {%- when '@app' -%}
      <div class="product__app-block" {{ block.shopify_attributes }}>{% render block %}</div>
  {%- endcase -%}
{%- endfor -%}
